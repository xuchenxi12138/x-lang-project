// db/core/socket.xle — 带缓冲的 TCP 连接
//
// ── 为什么直接包一层 netRecv/netSend ─────────────────
//
// 因为协议解析要「读满 N 字节」和「读一行」，而 netRecv 是**一次
// 调用拿当前可读的全部数据**。TCP 是流，一次 recv 可能只给半个包
// （尤其是跨网络），也可能把两个包粘在一起。
//
// 直接调 netRecv 的代码长这样：
//
//     let buf = ""
//     while (len(buf) < need) { buf = buf + netRecv(fd) }
//
// 这段逻辑七个驱动各写一遍，然后某一天有人忘了「buf 里可能已经多
// 出来下一个包的数据」，于是整个协议错位 —— 而这种 bug 只在网络
// 快、两次 recv 粘在一起时出现。
//
// 所以这里做 Conn：一个**带残留缓冲**的连接。读操作从缓冲里取，
// 不够才 recv，且 recv 多出来的部分留在缓冲里给下一次用。
//
// ── 缓冲为什么是字节数组而不是 String ────────────────
//
// 因为 String 的 len / strSub 按**码点**计数，而缓冲里是任意二进制。
// 实测：strFromBytes([0x00,0xE5,0xBC,0xA0,0xFF,0x41]) 的 len() 是
// 4 而字节数是 6，strSub(buf,0,2) 会给出 4 个字节。用它做缓冲，只要
// 报文里出现「看起来像 UTF-8 首字节」的随机值，读游标就会漂移，
// 而且**不报错**，只是数据错位。
//
// 所以 buf 是 Array，游标是字节下标，读写都走 bbXxx 系列。
//
// ── 为什么是 class 而不是 struct ──────────────────
//
// 因为读操作天然是「原地推进读游标」。struct 的字段在 P0.5 里不可变，
// 用它就得每读一次返回一个新值，调用点会变成
//
//     let r = connReadN(c, 4)
//     c = r[0]
//     let data = r[1]
//
// 而连接本来就是**有身份的、共享的、可变的**资源，用 class 才符合
// 它的本质。
//
// ── 为什么不阻塞到读满 ────────────────────────────
//
// 因为轮询模型（主循环 / HTTP pump）不能被阻塞。所有读操作都可能
// 返回「暂时不够」，调用方用 ok 标志判断。

from "endpoint.xle" import endpointOf, endpointWithTimeout, endpointString, Endpoint, PORT_MYSQL, PORT_POSTGRES, PORT_ORACLE, PORT_REDIS, PORT_MONGO, PORT_ES
from "../codec/bytes.xle" import bbNew, bbFromUtf8, bbFromRaw, bbPut, bbPutBytes, bbPutUtf8, bbPutRaw, bbPutU8, bbPutU16BE, bbPutU16LE, bbPutU24BE, bbPutU24LE, bbPutU32BE, bbPutU32LE, bbPutU64BE, bbPutU64LE, bbAt, bbU8, bbU16BE, bbU16LE, bbU24BE, bbU24LE, bbU32BE, bbU32LE, bbU64BE, bbU64LE, bbToText, bbToWire, bbSlice, bbHex, bbEq, bbIndexOf, bbConcat, bbClone, bbConcat3, bbFindSeq, bbSplitSeq

// 缓冲区最大保留量。防止对端狂发数据时内存无上限增长。
const SOCK_READ_CAP = 1048576     // 1 MiB

// 缓冲压缩阈值：已消费超过这么多字节才值得做一次切片。
const SOCK_COMPACT_AT = 65536

// 等待数据时的轮询间隔（毫秒）。太小会空转烧 CPU，太大会让单次
// 查询的多轮往返累积成明显的延迟。
const SOCK_POLL_MS = 5

// 默认等待预算（毫秒）。局域网内的数据库响应通常在 1ms 内，1 秒
// 的预算足以覆盖「服务端在算一个大查询」，同时不至于让断线卡死。
const SOCK_DEFAULT_WAIT_MS = 1000

class Conn {
    // 底层句柄。netListen / netConnect 返回的就是它。负数 = 无效。
    fd: Int,

    // 已经收到但还没被消费的字节。
    buf: Array,

    // 读缓冲里已经消费到的字节位置。
    //
    // ── 为什么用「位置」而不是每读一点就删前缀 ────────
    //
    // Array 的 arrSlice 是 O(n) 复制。一个 4KB 的包读 10 个字段就要
    // 复制 10 次 —— 40KB 的无谓拷贝。用游标只付一次切片代价（compact）。
    pos: Int,

    // 是否已关闭。
    closed: Bool,

    // 累计收发字节数（诊断用）。
    bytesIn: Int,
    bytesOut: Int,

    // 最近一次错误信息。
    lastError: String,

    // 端点（重连时要用）。
    host: String,
    port: Int,

    // 单次 recv 的临时数组。复用避免每次分配。
    scratch: Array,

    // 读操作的等待预算（毫秒）。由 Endpoint.timeoutMs 决定。
    //
    // ── 为什么超时是「读」的属性而不是「连接」的属性 ──────
    //
    // 因为连接建立（TCP 三次握手）由内核负责，语言层无法设定；
    // 而「等响应等多久」是驱动要自己决定的策略。放在这里让每个
    // 连接独立可调，池里的长连接和一次性探测可以用不同预算。
    waitMs: Int,

    constructor(fd: Int, host: String, port: Int) {
        self.fd        = fd
        self.buf       = []
        self.pos       = 0
        self.closed    = (fd < 0)
        self.bytesIn   = 0
        self.bytesOut  = 0
        self.lastError = ""
        self.host      = host
        self.port      = port
        self.scratch   = []
        self.waitMs    = SOCK_DEFAULT_WAIT_MS
    }

    // 设定等待预算，返回自身以支持链式写法。
    fn withWait(ms: Int) -> Conn {
        if (ms > 0) { self.waitMs = ms }
        return self
    }

    // ── 连接 ────────────────────────────────────

    static fn dial(ep: Endpoint) -> Conn {
        let fd = netConnect(ep.host, ep.port)
        let c = new Conn(fd, ep.host, ep.port)
        if (ep.timeoutMs > 0) { c.waitMs = ep.timeoutMs }
        if (fd < 0) {
            c.lastError = "无法连接 " + endpointString(ep) + "：" + netError()
        }
        return c
    }

    fn isOpen() -> Bool {
        return !self.closed && self.fd >= 0
    }

    fn close() {
        if (self.fd >= 0 && !self.closed) {
            netClose(self.fd)
        }
        self.closed = true
        self.fd     = 0 - 1
        self.buf    = []
        self.pos    = 0
    }

    // ── 写 ────────────────────────────────────

    // 发送一段字节。
    //
    // ── 为什么这里可以接受 String ─────────────────────
    //
    // netSend 拿的是 String 的**原始字节**（运行时按 data+len 发），
    // 不做编码转换。所以 strFromBytes 的产物（每字节一码点）可以
    // 原样发出去，实测 5 字节发送就返回 5。
    //
    // 但直接传真实文本（"张三"）也正确 —— 那是 UTF-8 字节。两种
    // 都能用，所以这里收 String，由 sendBytes 负责从 Array 转换。
    fn send(data: String) -> Int {
        if (!self.isOpen()) { return 0 - 1 }
        let n = netSend(self.fd, data)
        self.bytesOut  = self.bytesOut + n
        self.lastError = netError()
        return n
    }

    // 发送一个字节数组。
    //
    // ── 为什么要先拼成一个大 String 再发 ────────────────
    //
    // netSend 每次调用都有系统调用开销。一个 MySQL 查询包由十几个
    // 字段组成，逐字段发送就是十几次 syscall，而拼一次只需要一次
    // 内存拷贝。局域网内这是十倍级的差异。
    fn sendBytes(bytes: Array) -> Int {
        return self.send(bbToWire(bytes))
    }

    // ── 读 ────────────────────────────────────

    // 从内核读一批数据进缓冲。返回是否读到了东西。
    //
    // ── 为什么读到空串不直接判「连接已断」 ─────────────
    //
    // netRecv 在「连接正常但暂无数据」与「对端已关闭」两种情况下都
    // 返回空串 —— 运行时没有区分（见 interp.c 的 netRecv 注释）。
    // 所以这里保守处理：读到空串只说「暂时没数据」。真断了的时候
    // 下一次 send/recv 会让 netError 给出明确消息。
    fn fill() -> Bool {
        if (!self.isOpen()) { return false }
        if (len(self.buf) - self.pos > SOCK_READ_CAP) { return true }

        let chunk = netRecv(self.fd)
        if (len(chunk) == 0) { return false }

        // netRecv 给的是 String，转成字节数组才能安全按下标切片。
        let cb = strBytes(chunk)
        let n  = len(cb)

        // 已消费很多时先压缩，避免缓冲无限增长（长连接跑几天会吃光内存）。
        if (self.pos > SOCK_COMPACT_AT && self.pos * 2 > len(self.buf)) {
            self.buf = bbSlice(self.buf, self.pos, len(self.buf))
            self.pos = 0
        }
        var i = 0
        while i < n {
            arrPush(self.buf, toInt(cb[i]))
            i = i + 1
        }
        self.bytesIn = self.bytesIn + n
        return true
    }

    // 缓冲里还有多少**未消费**字节。
    fn avail() -> Int {
        return len(self.buf) - self.pos
    }

    // 尝试读满 n 字节。返回 [ok, 字节数组]。
    //
    // ── 为什么返回数组而不是用出参 ──────────────────────
    //
    // P0 的数组没有「预分配槽位」的概念：`let out = []` 是长度 0，
    // 对它写 `out[0] = x` 会报「数组下标越界」。要做出参就得让调用
    // 方先 `[0]` 造一个长度 1 的数组，而数组里放 null 会污染整个
    // 数组的元素类型推断（引发别处的 `宿主是 Null` 错误）。
    //
    // 所以用返回 [ok, data]，调用方写 `let r = c.readN(4)` 然后
    // `r[0]` / `r[1]`。失败时 r[1] 是空数组，len() 为 0，调用方
    // 可以直接用它判断。
    fn readN(n: Int) -> Array {
        if (n <= 0) {
            return [true, []]
        }
        // ── 为什么这里是「等待 + 重试」而不是一次 fill 失败就返回 ──
        //
        // TCP 上「这次没拿到数据」不等于失败：服务端可能还在处理
        // （Redis 的单线程会先排队，MySQL 要解析 SQL）。一次失败
        // 就当 EOF，调用方会把一个还没到的响应读成空，此后每个
        // 响应都错位一格。实测症状：AUTH 读成 eof、PING 读成空、
        // SET 读到的是 PONG 的结果。
        //
        // 所以按 waitMs 的预算退避重试。超出预算才算真的超时。
        var waited = 0
        while (self.avail() < n) {
            if (self.fill()) { waited = 0 }
            if (!self.isOpen()) { return [false, []] }
            if (waited >= self.waitMs) { return [false, []] }
            sleep(SOCK_POLL_MS)
            waited = waited + SOCK_POLL_MS
        }
        let data = bbSlice(self.buf, self.pos, self.pos + n)
        self.pos = self.pos + n
        return [true, data]
    }

    // 读一行（到 \n 为止，**含** \n）。返回 [ok, 字节数组]。
    fn readLine() -> Array {
        var waited = 0
        while true {
            let k = bbIndexOf(self.buf, 0x0A, self.pos)
            if (k >= 0) {
                let data = bbSlice(self.buf, self.pos, k + 1)
                self.pos = k + 1
                return [true, data]
            }
            if (self.fill()) { waited = 0 }
            if (!self.isOpen()) { return [false, []] }
            if (waited >= self.waitMs) { return [false, []] }
            sleep(SOCK_POLL_MS)
            waited = waited + SOCK_POLL_MS
        }
    }

    // 读一行并去掉行尾的 \r\n / \n，转成文本。失败返回 ""。
    fn readTextLine() -> String {
        let r = self.readLine()
        if (r[0] != true) { return "" }
        let line = r[1]
        var n = len(line)
        while n > 0 && bbAt(line, n - 1) == 0x0A {
            n = n - 1
        }
        if (n > 0 && bbAt(line, n - 1) == 0x0D) { n = n - 1 }
        return bbToText(bbSlice(line, 0, n))
    }

    // 丢弃缓冲里所有数据（协议错位后重新同步用）。
    fn drain() {
        self.buf = []
        self.pos = 0
    }

    // 清掉已消费的前缀。长连接定期调用可以回收内存。
    fn compact() {
        if (self.pos == 0) { return }
        self.buf = bbSlice(self.buf, self.pos, len(self.buf))
        self.pos = 0
    }

    // 静态：把字节数组变成可发送的 String。
    //
    // 单独给个名字是为了让「这里发生了字节→String 的跨越」在调用点
    // 可见。真正的实现只有一句 strFromBytes —— 它按字节原样构造，
    // 不做任何编码转换。
    static fn toWire(b: Array) -> String {
        return bbToWire(b)
    }
}

// ── 端口探测 ──────────────────────────────────────
//
// 「目标端口是否可达」是驱动健康检查的核心。它**不**建立完整连接
// （不握手、不发协议），只回答「TCP 层通不通」。
fn sockProbe(host: String, port: Int) -> Bool {
    let fd = netConnect(host, port)
    if (fd < 0) { return false }
    netClose(fd)
    return true
}

// 带多次重试的探测。数据库通常在容器里，启动顺序不保证。
fn sockProbeRetry(host: String, port: Int, times: Int, gapMs: Int) -> Bool {
    var i = 0
    while i < times {
        if (sockProbe(host, port)) { return true }
        i = i + 1
        if (i < times) { sleep(gapMs) }
    }
    return false
}