from std.str import strIsEmpty, strIsBlank, strTrimStart, strTrimEnd, strPadLeft, strPadRight, strPadCenter, strDisplayWidth, strPadDisplayRight, strSplitN, strLines, strLineCount, strReplaceN, strFindNth, strCount, strReverse, strFirstLine, strEllipsis, strIsInt, strIsFloat, strChar, strRule, strBasename, strDirname, strExtname, strJoinPath, strTemplate

// ============================================================
// std.conv —— 类型转换与格式化
// ============================================================
//
// 语言内建的转换只有三个：toInt / toFloat / toString。它们
// 严格、直接、不失败返回垃圾值（toInt("abc") 会报错而不是给 0）。
//
// 这里补的是**宽松版本与格式化版本**：
//   · 解析失败给默认值（读配置、解析用户输入时必须能容错）
//   · 进制转换（十六进制/二进制在调试与协议代码里每天都用）
//   · 定宽数字格式化（报表、对齐输出）
//   · 布尔的各种文本形态（"true"/"1"/"yes"/"on" 都该认）

// ---- 宽松解析 ----

// 解析整数，失败给默认值。不报错。
fn toIntOr(s: String, def: Int) -> Int {
    let t = strTrim(s)
    if (!convIsIntLike(t)) { return def }
    return strParseInt(t)
}

fn toFloatOr(s: String, def: Float) -> Float {
    let t = strTrim(s)
    if (!convIsFloatLike(t)) { return def }
    return strParseFloat(t)
}

// 内部：是否像整数（可带符号）
fn convIsIntLike(s: String) -> Bool {
    if (len(s) == 0) { return false }
    var i = 0
    let c0 = strAt(s, 0)
    if (c0 == "+" || c0 == "-") { i = 1 }
    if (i >= len(s)) { return false }
    while (i < len(s)) {
        let cp = strCode(strAt(s, i))
        if (cp < 48 || cp > 57) { return false }
        i = i + 1
    }
    return true
}

// 内部：是否像浮点（可带符号、小数点、指数）
fn convIsFloatLike(s: String) -> Bool {
    if (len(s) == 0) { return false }
    var i = 0
    let c0 = strAt(s, 0)
    if (c0 == "+" || c0 == "-") { i = 1 }
    var digits = 0
    var dots = 0
    while (i < len(s)) {
        let c = strAt(s, i)
        let cp = strCode(c)
        if (cp >= 48 && cp <= 57) {
            digits = digits + 1
        } else if (c == ".") {
            dots = dots + 1
            if (dots > 1) { return false }
        } else if (c == "e" || c == "E") {
            if (digits == 0) { return false }
            return convIsIntLike(strSub(s, i + 1, len(s)))
        } else {
            return false
        }
        i = i + 1
    }
    return digits > 0
}

// ---- 布尔 ----

// 宽松的真值判断。认这些写法：
//   真：true TRUE True yes YES y on 1
//   假：false FALSE False no NO n off 0 空串
// 不认识的一律给默认值，不猜 —— 猜错会让配置项静默生效或失效。
fn toBool(s: String) -> Bool {
    let t = strLower(strTrim(s))
    if (t == "true" || t == "yes" || t == "y" || t == "on" || t == "1") { return true }
    return false
}

fn toBoolOr(s: String, def: Bool) -> Bool {
    let t = strLower(strTrim(s))
    if (t == "true" || t == "yes" || t == "y" || t == "on" || t == "1") { return true }
    if (t == "false" || t == "no" || t == "n" || t == "off" || t == "0" || t == "") { return false }
    return def
}

fn boolToString(b: Bool) -> String {
    if (b) { return "true" }
    return "false"
}

// ---- 进制 ----

// 十进制 → 指定进制（2..36）的小写字符串。负数带前导 '-'。
fn toBase(n: Int, base: Int) -> String {
    if (base < 2 || base > 36) {
        fail("toBase: 进制必须在 2..36 之间（收到 " + toString(base) + "）")
    }
    if (n == 0) { return "0" }
    let digits = "0123456789abcdefghijklmnopqrstuvwxyz"
    var neg = false
    var v = n
    if (v < 0) {
        // Int 的最小值取负会溢出，所以先转 Float 再截断不现实。
        // 这里用「先取模再除」的写法避开对 -v 的依赖。
        neg = true
    }
    var out = ""
    while (v != 0) {
        var d = v % base
        if (d < 0) { d = -d }   // 负数取模在 C 系语言里给负值
        out = strAt(digits, d) + out
        v = v / base
    }
    if (neg) { return "-" + out }
    return out
}

fn toHex(n: Int) -> String {
    return toBase(n, 16)
}

fn toBin(n: Int) -> String {
    return toBase(n, 2)
}

fn toOct(n: Int) -> String {
    return toBase(n, 8)
}

// 十六进制字符串 → 整数。忽略 0x 前缀。非法字符报错。
fn fromHex(s: String) -> Int {
    var t = strTrim(s)
    if (strStarts(strLower(t), "0x")) {
        t = strSub(t, 2, len(t))
    }
    if (len(t) == 0) {
        fail("fromHex: 空字符串")
    }
    var v = 0
    var i = 0
    while (i < len(t)) {
        let c = strLower(strAt(t, i))
        var d = -1
        let cp = strCode(c)
        if (cp >= 48 && cp <= 57) {
            d = cp - 48
        } else if (cp >= 97 && cp <= 102) {
            d = cp - 97 + 10
        }
        if (d < 0) {
            fail("fromHex: 非法字符 `" + c + "`（第 " + toString(i) + " 位）")
        }
        v = v * 16 + d
        i = i + 1
    }
    return v
}

fn fromBin(s: String) -> Int {
    let t = strTrim(s)
    if (len(t) == 0) {
        fail("fromBin: 空字符串")
    }
    var v = 0
    var i = 0
    while (i < len(t)) {
        let c = strAt(t, i)
        if (c == "1") {
            v = v * 2 + 1
        } else if (c == "0") {
            v = v * 2
        } else {
            fail("fromBin: 非法字符 `" + c + "`（第 " + toString(i) + " 位）")
        }
        i = i + 1
    }
    return v
}

// ---- 数字格式化 ----

// 定宽，左补零。用于时间、编号、对齐输出。
fn padZero(n: Int, width: Int) -> String {
    let s = toString(n)
    let neg = strStarts(s, "-")
    var body = s
    if (neg) { body = strSub(s, 1, len(s)) }
    let padded = strPadLeft(body, width, "0")
    if (neg) { return "-" + padded }
    return padded
}

// 保留 n 位小数。不依赖 printf 的 %.*f，用手算 + 四舍五入。
//
// 手算的理由：语言没有 printf 格式化能力，而 toString(0.1+0.2)
// 会给出 0.30000000000000004 这种既正确又难看的输出。报表场景
// 需要「看起来正常」的数字。
fn fixed(x: Float, decimals: Int) -> String {
    if (decimals < 0) { decimals = 0 }
    if (decimals > 15) { decimals = 15 }
    let neg = x < 0.0
    var a = math(abs, x)

    // 乘 10^decimals 后四舍五入成整数，再手工插小数点
    var scale = 1.0
    var k = 0
    while (k < decimals) {
        scale = scale * 10.0
        k = k + 1
    }
    let shifted = math(round, a * scale)
    let ip = toInt(shifted)

    var body = toString(ip)
    if (decimals > 0) {
        body = padZero(ip, decimals + 1)
        let cut = len(body) - decimals
        body = strSub(body, 0, cut) + "." + strSub(body, cut, len(body))
    }
    if (neg) { return "-" + body }
    return body
}

// 千分位分组：1234567 → "1,234,567"
fn thousands(n: Int) -> String {
    let s = toString(n)
    let neg = strStarts(s, "-")
    var body = s
    if (neg) { body = strSub(s, 1, len(s)) }
    var out = ""
    var i = 0
    let total = len(body)
    while (i < total) {
        if (i > 0 && (total - i) % 3 == 0) {
            out = out + ","
        }
        out = out + strAt(body, i)
        i = i + 1
    }
    if (neg) { return "-" + out }
    return out
}

// 百分比：0.7532 → "75.3%"（保留 1 位）
fn percent(x: Float, decimals: Int) -> String {
    return fixed(x * 100.0, decimals) + "%"
}

// 字节数 → 人类可读：1536 → "1.5 KB"
fn bytes(n: Float) -> String {
    let neg = n < 0.0
    var a = math(abs, n)
    let units = array(4, "")
    units[0] = "B"
    units[1] = "KB"
    units[2] = "MB"
    units[3] = "GB"
    var u = 0
    while (a >= 1024.0 && u < 3) {
        a = a / 1024.0
        u = u + 1
    }
    var body = ""
    if (u == 0) {
        body = fixed(a, 0) + " " + units[u]
    } else {
        body = fixed(a, 1) + " " + units[u]
    }
    if (neg) { return "-" + body }
    return body
}

// ---- 数组 ↔ 字符串 ----

// 数字数组 → 用逗号连起来的字符串。报表/日志最常用。
fn numbersToString(xs: Array) -> String {
    var out = ""
    var i = 0
    while (i < len(xs)) {
        if (i > 0) { out = out + "," }
        out = out + toString(xs[i])
        i = i + 1
    }
    return out
}

// 逗号分隔字符串 → 数字数组。空白会被忽略，非法项报错。
fn stringToNumbers(s: String) -> Array {
    let out = array(0, 0.0)
    let parts = strSplit(s, ",")
    var i = 0
    while (i < len(parts)) {
        let t = strTrim(parts[i])
        if (len(t) > 0) {
            if (!convIsFloatLike(t)) {
                fail("stringToNumbers: 第 " + toString(i + 1) + " 项 `" + t + "` 不是数字")
            }
            arrPush(out, strParseFloat(t))
        }
        i = i + 1
    }
    return out
}

// 逗号分隔整数串 → 整数数组（"1,2,3" 这种配置项的常见形态）
fn stringToInts(s: String) -> Array {
    let out = array(0, 0)
    let parts = strSplit(s, ",")
    var i = 0
    while (i < len(parts)) {
        let t = strTrim(parts[i])
        if (len(t) > 0) {
            if (!convIsIntLike(t)) {
                fail("stringToInts: 第 " + toString(i + 1) + " 项 `" + t + "` 不是整数")
            }
            arrPush(out, strParseInt(t))
        }
        i = i + 1
    }
    return out
}

// ---- 单字符与码点 ----

// 单个字符是否是空白
fn isSpace(c: String) -> Bool {
    return c == " " || c == "\t" || c == "\n" || c == "\r"
}

// 单个字符是否是可打印 ASCII
fn isPrintableAscii(c: String) -> Bool {
    if (len(c) != 1) { return false }
    let cp = strCode(c)
    return cp >= 32 && cp <= 126
}

// 码点 → 可读的转义形式，用于调试输出不可见字符
fn escapeChar(c: String) -> String {
    let cp = strCode(c)
    if (cp == 10) { return "\\n" }
    if (cp == 9)  { return "\\t" }
    if (cp == 13) { return "\\r" }
    if (cp == 0)  { return "\\0" }
    if (cp < 32)  { return "\\u{" + toString(cp) + "}" }
    return c
}