// ui/control/label.xle — 文字标签
//
// ── 标签为什么独立成类而不是「直接调 uiText」 ─────────
//
// 因为标签需要参与布局。「直接调 uiText 画一行字」是绘制原语，
// 而标签是**控件**：它有边界（供布局器分配空间）、有可见性
// （供条件显示）、有对齐方式（供排版）。这两者不能混为一谈 ——
// 绘制原语不该有状态，控件必须有。
//
// ── 为什么没有 padding 字段 ────────────────────
//
// 内边距属于容器（Panel 有 pad，VBox 有 gap），不属于文字本身。
// 给标签加 padding 会导致「标签的 padding 和容器的 padding 相加」
// 这种双重留白，而排错时要同时看两处。标签只填满它的矩形。

from "../widget/widget.xle" import Widget, WSTATE_NORMAL, WSTATE_HOVER, WSTATE_ACTIVE, WSTATE_FOCUS, WSTATE_DISABLED, W_FOCUS_W
from "../core/text.xle" import uiTextWidth, uiTextHeight, uiLineCount, uiTextInRect, uiTextLeft, uiTextRight, uiTextTopLeft, uiTextCentered, uiTextCenter, uiTextLeftAt, uiEllipsize, uiTruncate, uiEllipsizeEnd, uiLastFind, uiWrapLines, uiTextBlock, UI_FONT_H
from "../core/rect.xle" import rectOf, rectFromLTRB, rectZero, Rect, rectCentered
from "../core/theme.xle" import Theme
from "../core/palette.xle" import UI_BG, UI_SURFACE, UI_SURFACE_H, UI_SURFACE_A, UI_BORDER, UI_TEXT, UI_TEXT_DIM, UI_ACCENT, UI_ACCENT_D, UI_OK, UI_WARN, UI_ERR, UI_TRACK, UI_SCRIM, UI_SHADOW, UI_FOCUS, UI_DISABLED, UI_NONE

// 对齐方式。数值与 Style.align 一致，可以直接互换。
const TEXT_CENTER = 0
const TEXT_LEFT   = 1
const TEXT_RIGHT  = 2

class Label extends Widget {
    text: String,

    // 前景色。UI_NONE 表示「跟随主题的正文色」—— 这是默认值，
    // 好处是主题切换时不用改任何标签。只有需要强调的标签
    //（错误信息、成功提示）才显式设色。
    color: Int,

    // 对齐方式，取值 TEXT_*。
    align: Int,

    // 是否用次要文字色。这是「语义」而不是颜色值 —— 调用方说
    // 「这条是次要信息」而不是「这条是灰的」，主题才能自己决定
    // 灰成什么样。
    dim: Bool,

    // 字体放大倍数（百分比，100 = 正常）。用于标题。
    //
    // 语言侧的 winText 没有字号参数，所以这里做不到真正的缩放。
    // 保留字段是为了让 API 稳定 —— 等 winFont 落地后这一个字段
    // 就能生效，而不是届时改所有调用点。当前实现会忽略它，
    // 但会在需要时用大写字母转换之类的手段做视觉区分。
    scale: Int,

    constructor(r: Rect, text: String) {
        self.r       = r
        self.vis     = true
        self.enabled = true
        self.focused = false
        self.hovered = false
        self.text    = text
        self.color   = UI_NONE
        self.align   = TEXT_LEFT
        self.dim     = false
        self.scale   = 100
        self.style   = Style.plain()
    }

    // ── 工厂 ────────────────────────────────────

    static fn centered(r: Rect, text: String) -> Label {
        let l = new Label(r, text)
        l.align = TEXT_CENTER
        return l
    }

    static fn right(r: Rect, text: String) -> Label {
        let l = new Label(r, text)
        l.align = TEXT_RIGHT
        return l
    }

    // 次要文字。表单的说明、表格的空状态提示都用这个。
    static fn muted(r: Rect, text: String) -> Label {
        let l = new Label(r, text)
        l.dim = true
        return l
    }

    // 错误文字。红色 + 左对齐。
    static fn error(r: Rect, text: String) -> Label {
        let l = new Label(r, text)
        l.dim = false
        return l
    }

    // ── 状态 ────────────────────────────────────

    fn setText(t: String) -> Label {
        self.text = t
        return self
    }

    fn setAlign(a: Int) -> Label {
        self.align = a
        return self
    }

    fn tint(c: Int) -> Label {
        self.color = c
        return self
    }

    fn setDim(v: Bool) -> Label {
        self.dim = v
        return self
    }

    // ── 实际生效的颜色 ─────────────────────────────
    //
    // 优先级：显式色 > 禁用色 > 次要色 > 正文色。
    //
    // 禁用态优先于次要态，是因为「禁用」是更强的语义：一个禁用的
    // 次要标签应该看起来「既灰又不重要」，而不是「只是次要」。
    fn effectiveColor(th: Theme) -> Int {
        if (!self.enabled) { return th.disabled }
        if (self.color != UI_NONE) { return self.color }
        if (self.dim) { return th.textDim }
        return th.text
    }

    // ── 绘制 ────────────────────────────────────

    fn draw(th: Theme) {
        if (!self.vis) { return }
        if (len(self.text) == 0) { return }

        let c = self.effectiveColor(th)

        // 超长时省略。标签的宽度通常由布局给出，而布局不知道
        // 文字有多宽 —— 所以省略是标签自己的责任。
        var s = self.text
        if (winTextWidth(s) > self.r.w) {
            s = uiEllipsize(s, self.r.w)
        }

        if (self.align == TEXT_LEFT) {
            uiTextLeft(self.r, s, 0, c)
        } else if (self.align == TEXT_RIGHT) {
            uiTextRight(self.r, s, 0, c)
        } else {
            uiTextInRect(self.r, s, c)
        }
    }

    // ── 多行版本 ─────────────────────────────────
    //
    // 段落文字需要折行，而折行后的高度是动态的。所以这条路径
    // 返回实际占用高度，供调用方（通常是 VBox）接着往下排。
    //
    // 为什么不放在 draw 里做：draw 应该是幂等的纯绘制，而
    // 「算出用了多高」是布局信息，调用方需要拿到它。分开两个
    // 函数比让 draw 返回值更清楚。
    fn drawWrapped(th: Theme, lineH: Int) -> Int {
        if (!self.vis) { return 0 }
        let c = self.effectiveColor(th)
        let lines = uiWrapLines(self.text, self.r.w)
        return uiTextBlock(self.r, lines, lineH, 0, c)
    }

    // 折行后需要的高度。布局阶段（还没开始画）用这个来预留空间。
    fn heightFor(width: Int, lineH: Int) -> Int {
        let n = uiLineCount(self.text, width)
        return n * lineH
    }
}