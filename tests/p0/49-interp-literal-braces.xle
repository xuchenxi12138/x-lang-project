// 49-interp-literal-braces.xle — 花括号何时算插值、何时算字面量
//
// v0.17 的兼容性裁决（方案一）：判据是「能不能真解析成一个完整表达式」，
// 不是首字符、不是白名单。任一成立就**当字面量原样输出**：
//
//   1. 内容为空：`{}`
//   2. 内容解析后没能吃完全部 token：`{"a":1}` 会剩 `:`
//   3. 内容解析时报了错：`{a b}`
//   4. `{` 没有配对的 `}`：`"a{b"`
//
// 为什么要有这条：`"{}"` 和 `"{\"a\":1}"` 是 JSON 里最常见的两个字符串。
// 若一律当插值，所有 JSON 代码立刻编译不过（实测 23-stdlib-json 就因此
// 回归失败一次）。插值只是字符串的一个可选用法，不该对不用的写法收税。
//
// 代价（刻意接受）：真正的插值写错时不会报错，而是静默原样输出。
// 比如 `"值={x"` 会输出 `值={x`，不提示「插值未闭合」。这笔交易换来的是
// 「任何不含插值的字符串都不需要思考转义」。

fn f(n: Int) -> Int { return n * 3 }

fn main() -> Int {
    let x = 7

    // ---- 应当当字面量 ----
    println("{}")                     // {}
    println("empty={}")               // empty={}
    println("{\"a\":1}")              // {"a":1}
    println("{\"a\":1,\"b\":2}")      // {"a":1,"b":2}
    println("a{b")                    // a{b   —— 未闭合，不报错
    println("}{")                     // }{    —— 闭合在前，也是字面量
    println("{ }")                    // { }   —— 只有空格，解析不出表达式

    // ---- 应当当插值 ----
    println("{x}")                    // 7
    println("{x + 1}")                // 8
    println("{f(2)}")                 // 6

    // ---- 同一串里混着两种 ----
    println("{}x{x}")                 // {}x7

    // ---- JSON 里嵌插值：最能说明这个设计的价值 ----
    let id = 42
    println("{\"id\":{id}}")          // {"id":42}

    return 0
}