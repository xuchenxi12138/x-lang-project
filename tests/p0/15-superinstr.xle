// 15-superinstr.xla — 超指令合并的回归测试
//
// 这个文件的存在理由：超指令合并有一个**不带任何报错的**故障模式，
// 靠普通测试很容易漏掉。它验证的是三件事：
//
//   1. 多函数 + 循环 + 递归同时存在时，跳转仍然指向正确的指令。
//      合并 pass 从后往前逐函数处理，先合并的函数会被后合并的
//      更靠前的函数挤动，操作数必须跟着改。漏改的症状是：
//      不报错、不崩溃，只是算错 —— 因为跳转跳过头之后栈上少压了
//      一个操作数，解释器读到的是上一次残留的值，类型完全合法。
//
//   2. 函数定义顺序不影响结果。把小函数写在前面（合并量大、挤动
//      后续函数的次数多）和写在后面，必须得到相同的输出。
//      上面那个 bug 只在「合并发生在被挤动函数的更前面」时出现，
//      所以顺序是触发条件之一。
//
//   3. --nosuper 与默认编译的输出必须逐字节一致。
//      超指令是纯性能优化，不得改变任何语义。这一条由
//      run_tests.sh 对每个测试自动执行，本文件只是提供一份
//      足够复杂的字节码让它有东西可查。
//
// 本文件的每个断言值都是手算的，不是从解释器输出抄回来的。

// ── 小函数在前：它的合并会挤动下面所有函数 ──
fn sq(n: Int) -> Int {
    return n * n
}

fn cube(n: Int) -> Int {
    return n * sq(n)
}

// 带循环 + 带递归的复合函数。跳转密集，是重映射最容易出错的地方。
fn fact(n: Int) -> Int {
    if n <= 1 {
        return 1
    }
    return n * fact(n - 1)
}

fn sum_to(n: Int) -> Int {
    var total = 0
    var i = 1
    while i <= n {
        total += i
        i += 1
    }
    return total
}

// 嵌套循环：两层回边 + 内层 continue 跳转，下标重映射压力最大
fn grid(n: Int) -> Int {
    var total = 0
    var i = 0
    while i < n {
        var j = 0
        while j < n {
            if j == i {
                j += 1
                continue
            }
            total += 1
            j += 1
        }
        i += 1
    }
    return total
}

fn main() {
    // 手算：4^2=16, 3^3=27, 6!=720, 1..10=55
    println(sq(4))
    println(cube(3))
    println(fact(6))
    println(sum_to(10))

    // 5×5 网格去掉 5 个对角格 = 20
    println(grid(5))

    // 组合起来算一遍，让各函数的调用点分散在 main 的不同位置：
    // 16 + 27 = 43; 720 / 43 整除部分 = 16 余 32
    // 55 + 20 = 75
    println(sq(4) + cube(3))
    println(fact(4) + sum_to(4))
    println(grid(3) + sum_to(3))
}