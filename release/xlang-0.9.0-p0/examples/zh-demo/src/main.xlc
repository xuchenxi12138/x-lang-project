// ── 矩阵 ──────────────────────────────────────────────
令 a = 零矩阵(2, 3)
设元素(a, 3, 0, 0, 1.0)
设元素(a, 3, 0, 1, 2.0)
设元素(a, 3, 0, 2, 3.0)
设元素(a, 3, 1, 0, 4.0)
设元素(a, 3, 1, 1, 5.0)
设元素(a, 3, 1, 2, 6.0)
令 b = 零矩阵(3, 2)
设元素(b, 2, 0, 0, 7.0)
设元素(b, 2, 0, 1, 8.0)
设元素(b, 2, 1, 0, 9.0)
设元素(b, 2, 1, 1, 10.0)
设元素(b, 2, 2, 0, 11.0)
设元素(b, 2, 2, 1, 12.0)
令 c = 矩阵乘(a, 2, 3, b, 2)
打印行(取元素(c, 2, 0, 0))
打印行(取元素(c, 2, 1, 1))

// ── 字符串 ────────────────────────────────────────────
令 s = "中文编程语言"
打印行(取子串(s, 2, 4))
打印行(查找(s, "编程"))
打印行(长度(切分("a,b,c", ",")))
打印行(拼接(切分("a,b,c", ","), "-"))
打印行(替换("你好世界", "世界", "中文"))
打印行(开头是(s, "中文"))
打印行(结尾是(s, "语言"))
打印行(重复("ab", 3))
打印行(码转字符(20013))
打印行(字符码("中"))
打印行(解析整数("456"))
打印行(去首尾空白("  x  ") + "|")
打印行(左补齐("7", 3, "0"))
打印行(显示宽度("中文a"))
打印行(出现次数(" banana ", "an"))
打印行(反转(s))

// ── 数组 ──────────────────────────────────────────────
令 ys = 建数组(4, 0)
追加(ys, 5)
追加(ys, 3)
追加(ys, 5)
打印行(长度(ys))
打印行(查找(ys, 3))
打印行(包含(ys, 5))
打印行(所有下标(ys, 5))
打印行(长度(取段(ys, 1, 3)))
打印行(长度(合并(ys, ys)))
打印行(长度(去重(ys)))
打印行(长度(展平(分块(ys, 3))))
打印行(长度(筛选大于(ys, 3.0)))
打印行(长度(每项转字符串(ys)))
倒转(ys)
令 翻倍 = 每项乘(已排序(ys), 2.0)
打印行(翻倍[0])

令 zs = 建数组(6, 0.0)
zs[0] = 5.0
zs[1] = 1.0
zs[2] = 4.0
zs[3] = 2.0
zs[4] = 3.0
zs[5] = 6.0
