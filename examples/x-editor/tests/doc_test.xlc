// 文档与编辑功能回归测试
//
// 覆盖四块：
//   文档模型   行编辑、光标选区、撤销重做、行操作
//   查找替换   大小写/全词/循环、批量替换
//   语法高亮   语言识别、标记类型、跨行状态
//   按键辅助   键码、字符、修饰位与键名
//
// 运行：
//   x run --profile=console examples/x-editor/tests/doc_test.xlc
//
// 输出末尾是通过/失败计数；失败会逐条打印名字。
// 断言用「计数数组」而不是全局变量：顶层变量是入口的局部量，
// 函数看不到它们，传数组是唯一稳定的共享方式。

从 @zh 引入 文档, 文本长度
从 @zh 引入 查找全部, 匹配数, 查找下一个, 查找上一个, 替换一处, 替换全部
从 @zh 引入 语言自研, 语言西, 语言数据, 语言网页, 语言蟒蛇, 语言标记
从 @zh 引入 着色关键字, 着色字符串, 着色注释, 着色数字, 着色函数, 着色标签, 着色键
从 @zh 引入 高亮行, 高亮状态, 语言自路径
从 @zh 引入 键码, 键字符, 键修饰, 键有字符, 按控制, 按上档, 按交替
从 @zh 引入 键名, 键功能3, 键退出
从 @zh 引入 打印行, 转字符串, 转整数, 长度, 开头是, 查找, 码转字符

函 断言(条件: 布尔, 名: 字符串, 计: 数组) {
    如果 (条件) {
        计[0] = 计[0] + 1
    } 否则 {
        计[1] = 计[1] + 1
        打印行("FAIL " + 名)
    }
}

// 着色标记数组里有某一类吗
函 有类型(标记们: 数组, 种类: 整数) -> 布尔 {
    变 序号 = 0
    当 (序号 < 长度(标记们)) {
        如果 (转整数(标记们[序号][2]) == 种类) { 返回 真 }
        序号 = 序号 + 1
    }
    返回 假
}

函 主() -> 整数 {
    变 计 = [0, 0]

    // ============================================================
    // 一、文档模型
    // ============================================================
    打印行("== 文档模型 ==")

    令 文档对象 = 新建 文档()
    断言(文档对象.行数() == 1, "空文档一行", 计)
    断言(长度(文档对象.文本()) == 0, "空文档文本为空", 计)

    文档对象.设文本("abc")
    断言(文档对象.行数() == 1, "单行行数", 计)
    断言(文档对象.字数() == 3, "单行字符数", 计)
    // 新文档默认使用回车换行，文本末尾补一个行尾符
    断言(长度(文档对象.文本()) == 5, "文本末尾带换行", 计)

    文档对象.设文本("第一行\n第二行\n第三行")
    断言(文档对象.行数() == 3, "三行行数", 计)
    断言(文档对象.行内容(1) == "第二行", "行内容", 计)

    // 中文按码点计数
    文档对象.设文本("中文")
    断言(文档对象.字数() == 2, "中文按码点计数", 计)
    断言(文本长度("中文abc") == 5, "文本长度按码点", 计)

    // 插入与换行
    文档对象.设文本("ac")
    文档对象.设光标(0, 1, 0)
    文档对象.插入文本("b")
    断言(文档对象.行内容(0) == "abc", "插入字符", 计)
    文档对象.插入文本("\n")
    断言(文档对象.行数() == 2, "插入换行拆行", 计)
    断言(文档对象.行内容(0) == "ab" && 文档对象.行内容(1) == "c", "拆行位置", 计)
    文档对象.设光标(1, 0, 0)
    文档对象.插入文本("d")
    断言(文档对象.行内容(1) == "dc", "第二行插入", 计)

    // 退格：行首退格应拼接上一行
    文档对象.设文本("ab\ncd")
    文档对象.设光标(1, 0, 0)
    文档对象.退格()
    断言(文档对象.行数() == 1, "行首退格拼行", 计)
    断言(文档对象.行内容(0) == "abcd", "拼行内容", 计)

    // 退格：行中删字符
    文档对象.设文本("abcd")
    文档对象.设光标(0, 4, 0)
    文档对象.退格()
    断言(文档对象.行内容(0) == "abc", "退格删字符", 计)

    // 向前删除
    文档对象.设光标(0, 1, 0)
    文档对象.向后删除()
    断言(文档对象.行内容(0) == "ac", "向前删除", 计)

    // 选区
    文档对象.设文本("hello world")
    文档对象.选区(0, 0, 0, 5)
    断言(文档对象.有选区(), "选区存在", 计)
    断言(文档对象.选中文本() == "hello", "选区文本", 计)
    断言(文档对象.选中字数() == 5, "选区字符数", 计)

    // 选区替换 = 删除后插入
    文档对象.插入文本("hi")
    断言(文档对象.行内容(0) == "hi world", "选区被替换", 计)

    // 撤销 / 重做
    断言(文档对象.可撤销(), "可撤销", 计)
    文档对象.撤销()
    断言(文档对象.行内容(0) == "hello world", "撤销恢复", 计)
    文档对象.重做()
    断言(文档对象.行内容(0) == "hi world", "重做生效", 计)

    // 行操作
    文档对象.设文本("a\nb\nc")
    文档对象.设光标(0, 0, 0)
    文档对象.复制当前行()
    断言(文档对象.行数() == 4, "复制行增加一行", 计)
    断言(文档对象.行内容(1) == "a", "复制行内容一致", 计)

    文档对象.设光标(1, 0, 0)
    文档对象.删除当前行()
    断言(文档对象.行数() == 3, "删除行", 计)
    断言(文档对象.行内容(0) == "a", "删除后首行", 计)

    // 缩进 / 取消缩进
    文档对象.设文本("x")
    文档对象.设光标(0, 0, 0)
    文档对象.缩进()
    断言(文档对象.行内容(0) == "    x", "制表键缩进 4 空格", 计)
    文档对象.减少缩进()
    断言(文档对象.行内容(0) == "x", "取消缩进", 计)

    // 注释切换
    文档对象.设文本("abc")
    文档对象.设光标(0, 0, 0)
    文档对象.切换注释("//", "")
    断言(开头是(文档对象.行内容(0), "//"), "加注释", 计)
    文档对象.切换注释("//", "")
    断言(文档对象.行内容(0) == "abc", "取消注释", 计)

    // 排序与行尾空白
    文档对象.设文本("c\na\nb")
    文档对象.选区(0, 0, 2, 1)
    文档对象.排序选中行()
    断言(文档对象.行内容(0) == "a" && 文档对象.行内容(2) == "c", "选中行排序", 计)

    文档对象.设文本("a   ")
    文档对象.删除行尾空白()
    断言(文档对象.行内容(0) == "a", "删除行尾空白", 计)

    // 大小写
    文档对象.设文本("abc")
    文档对象.选区(0, 0, 0, 3)
    文档对象.选区转大写()
    断言(文档对象.行内容(0) == "ABC", "选区转大写", 计)
    文档对象.选区转小写()
    断言(文档对象.行内容(0) == "abc", "选区转小写", 计)

    // 行尾符
    文档对象.设文本("a\nb")
    文档对象.转换换行(0)
    断言(文档对象.换行方式() == 0, "切换到回车换行", 计)
    断言(查找(文档对象.文本(), "\r\n") >= 0, "文本使用回车换行", 计)
    文档对象.转换换行(1)
    断言(文档对象.换行方式() == 1, "切换到换行", 计)

    // 跳转与光标边界
    文档对象.设文本("1\n2\n3\n4\n5")
    文档对象.跳到行(3)
    断言(文档对象.光标行() == 2, "跳到行从 1 开始", 计)
    文档对象.跳到行(99)
    断言(文档对象.光标行() == 4, "跳到行越界钳制", 计)
    文档对象.全选()
    断言(文档对象.有选区(), "全选产生选区", 计)

    // 设文本归一化
    文档对象.设文本("a\r\nb\rc")
    断言(文档对象.行数() == 3, "不同行尾符归一化", 计)

    // 标题
    文档对象.设路径("")
    文档对象.设名称("未保存 1")
    断言(文档对象.标题() == "未保存 1", "无路径用名称作标题", 计)

    // ============================================================
    // 二、查找替换
    // ============================================================
    打印行("== 查找替换 ==")

    文档对象.设文本("Foo foo food foo\nfoo")
    令 全 = 查找全部(文档对象, "foo", 0, 0)
    断言(长度(全) == 5, "不区分大小写找到 5 处", 计)
    断言(转整数(全[0][0]) == 0 && 转整数(全[0][1]) == 0, "首处位置", 计)

    令 严 = 查找全部(文档对象, "foo", 1, 0)
    断言(长度(严) == 4, "区分大小写 4 处", 计)

    令 词 = 查找全部(文档对象, "foo", 0, 1)
    断言(长度(词) == 4, "全词匹配排除更长的词", 计)
    断言(匹配数(文档对象, "foo", 0, 0) == 5, "匹配数与查找全部一致", 计)

    // 循环查找
    文档对象.设光标(0, 0, 0)
    断言(查找下一个(文档对象, "foo", 0, 0, 1), "向下找到", 计)
    令 首 = 文档对象.选区起点()
    断言(转整数(首[0]) == 0 && 转整数(首[1]) == 0, "第一处被选中", 计)
    查找下一个(文档对象, "foo", 0, 0, 1)
    令 次处 = 文档对象.选区起点()
    断言(转整数(次处[1]) == 4, "第二处被选中", 计)

    文档对象.设光标(0, 0, 0)
    断言(查找上一个(文档对象, "foo", 0, 0, 1), "向上查找循环到末尾", 计)
    断言(文档对象.光标行() == 1, "循环到第二行", 计)

    断言(!查找下一个(文档对象, "不存在", 0, 0, 1), "找不到返回假", 计)

    // 替换
    文档对象.设文本("aXbXc")
    文档对象.选区(0, 0, 0, 0)
    断言(替换一处(文档对象, "X", "-", 0, 0), "替换一处", 计)
    断言(文档对象.行内容(0) == "a-bXc", "只换第一处", 计)

    文档对象.设文本("aXbXc")
    令 次 = 替换全部(文档对象, "X", "-", 0, 0)
    断言(次 == 2, "全部替换计数", 计)
    断言(文档对象.行内容(0) == "a-b-c", "全部替换结果", 计)

    // 替换文本含换行
    文档对象.设文本("a,b")
    令 另次 = 替换全部(文档对象, ",", "\n", 0, 0)
    断言(另次 == 1 && 文档对象.行数() == 2, "替换为换行会拆行", 计)

    // 不重叠
    文档对象.设文本("aaa")
    断言(匹配数(文档对象, "aa", 0, 0) == 1, "匹配不重叠", 计)

    // ============================================================
    // 三、语法高亮
    // ============================================================
    打印行("== 语法高亮 ==")

    断言(语言自路径("a.xle") == 语言自研, "后缀识别自研语言", 计)
    断言(语言自路径("a.xlc") == 语言自研, "后缀识别中文模块", 计)
    断言(语言自路径("a.json") == 语言数据, "后缀识别数据格式", 计)
    断言(语言自路径("a.py") == 语言蟒蛇, "后缀识别蟒蛇语言", 计)
    断言(语言自路径("a.md") == 语言标记, "后缀识别标记格式", 计)
    断言(语言自路径("a.unknownext") == 0, "未知后缀为纯文本", 计)

    令 自研结果 = 高亮行("let x = 1 // 注释", 语言自研, 0)
    令 自研标记 = 自研结果[0]
    断言(有类型(自研标记, 着色关键字), "自研语言关键字着色", 计)
    断言(有类型(自研标记, 着色数字), "数字着色", 计)
    断言(有类型(自研标记, 着色注释), "行注释着色", 计)

    令 函结果 = 高亮行("fn run() {", 语言自研, 0)
    断言(有类型(函结果[0], 着色函数), "函数名着色", 计)

    令 串结果 = 高亮行("let s = \"hi\"", 语言自研, 0)
    断言(有类型(串结果[0], 着色字符串), "字符串着色", 计)

    // 西语块注释跨行
    令 西1 = 高亮行("/* start", 语言西, 0)
    断言(转整数(西1[1]) == 1, "块注释进入状态 1", 计)
    令 西2 = 高亮行("middle", 语言西, 1)
    断言(转整数(西2[1]) == 1 && 有类型(西2[0], 着色注释), "块注释延续", 计)
    令 西3 = 高亮行("end */ int x;", 语言西, 1)
    断言(转整数(西3[1]) == 0, "块注释结束状态 0", 计)

    // 数据格式的键与字符串
    令 左括号 = 码转字符(123)
    令 数据文本 = 左括号 + "\"name\": 1"
    令 数据结果 = 高亮行(数据文本, 语言数据, 0)
    断言(有类型(数据结果[0], 着色键), "数据键着色", 计)

    // 网页标签
    令 网页结果 = 高亮行("<div class=x>text</div>", 语言网页, 0)
    断言(有类型(网页结果[0], 着色标签), "网页标签着色", 计)

    // 标记格式标题
    令 标记结果 = 高亮行("# 标题", 语言标记, 0)
    断言(有类型(标记结果[0], 着色关键字), "标记格式标题着色", 计)

    // 每行一个起始状态
    令 行们 = ["/*", "x", "*/"]
    令 状 = 高亮状态(行们, 语言西)
    断言(长度(状) == 3, "高亮状态长度等于行数", 计)
    断言(转整数(状[1]) == 1, "第二行起始为注释中", 计)

    // ============================================================
    // 四、按键辅助
    // ============================================================
    打印行("== 按键辅助 ==")

    令 事件 = [键功能3, "", 0]
    断言(键码(事件) == 键功能3, "键码读取", 计)
    断言(键字符(事件) == "", "功能键无字符", 计)
    断言(!键有字符(事件), "无字符判定", 计)
    断言(键名(键功能3) == "F3", "功能键名", 计)
    断言(键名(键退出) == "Esc", "退出键名", 计)

    令 字符事件 = [0, "中", 2]
    断言(键字符(字符事件) == "中", "字符事件带中文", 计)
    断言(键修饰(字符事件) == 2, "修饰位读取", 计)
    断言(按控制(2), "控制位", 计)
    断言(!按上档(2), "非上档", 计)
    断言(!按交替(2), "非交替", 计)
    断言(按上档(1) && 按控制(2) && 按交替(4), "三个修饰位独立", 计)

    // ============================================================
    // 汇总
    // ============================================================
    打印行("PASS " + 转字符串(计[0]) + "  FAIL " + 转字符串(计[1]))
    返回 0
}
