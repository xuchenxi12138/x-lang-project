// db/codec/sha1.xle 里已有的 SHA-1 是 SHA-256 的基础 —— 先补 SHA-256，
// 因为 MySQL 8 默认的 caching_sha2_password 需要它。
//
// 本文件单独存在而不是塞进 sha1.xle：摘要算法是「一类工具库」，
// 按用户的工程要求该按算法分文件。

from "bytes.xle" import bbNew, bbFromUtf8, bbFromRaw, bbPut, bbPutBytes, bbPutUtf8, bbPutRaw, bbPutU8, bbPutU16BE, bbPutU16LE, bbPutU24BE, bbPutU24LE, bbPutU32BE, bbPutU32LE, bbPutU64BE, bbPutU64LE, bbAt, bbU8, bbU16BE, bbU16LE, bbU24BE, bbU24LE, bbU32BE, bbU32LE, bbU64BE, bbU64LE, bbToText, bbToWire, bbSlice, bbHex, bbEq, bbIndexOf, bbConcat, bbClone, bbConcat3, bbFindSeq, bbSplitSeq
from "sha1.xle" import Sha1, SHA1_H0, SHA1_H1, SHA1_H2, SHA1_H3, SHA1_H4, SHA1_MASK32
from "../../conv.xle" import toIntOr, toFloatOr, convIsIntLike, convIsFloatLike, toBool, toBoolOr, boolToString, toBase, toHex, toBin, toOct, fromHex, fromBin, padZero, fixed, thousands, percent, bytes, numbersToString, stringToNumbers, stringToInts, isSpace, isPrintableAscii, escapeChar

// SHA-256 初始哈希值（FIPS 180-4）。
const SHA256_H0 = 0x6A09E667
const SHA256_H1 = 0xBB67AE85
const SHA256_H2 = 0x3C6EF372
const SHA256_H3 = 0xA54FF53A
const SHA256_H4 = 0x510E527F
const SHA256_H5 = 0x9B05688C
const SHA256_H6 = 0x1F83D9AB
const SHA256_H7 = 0x5BE0CD19

const SHA256_MASK32 = 0xFFFFFFFF

class Sha256 {
    // 32 位循环右移。
    static fn rotr(x: Int, n: Int) -> Int {
        let v = x & SHA256_MASK32
        return ((v >> n) | (v << (32 - n))) & SHA256_MASK32
    }

    static fn rotl(x: Int, n: Int) -> Int {
        let v = x & SHA256_MASK32
        return ((v << n) | (v >> (32 - n))) & SHA256_MASK32
    }

    // 64 个轮常量。
    //
    // ── 为什么是函数而不是 const 数组 ────────────────
    //
    // P0 的顶层 const 只接受标量字面量，数组必须由函数返回。每次
    // 调用都新建一个数组（64 个 Int），对哈希这种「一次几百次调用」
    // 的量级完全可以接受。
    static fn k() -> Array {
        return [
            0x428A2F98, 0x71374491, 0xB5C0FBCF, 0xE9B5DBA5,
            0x3956C25B, 0x59F111F1, 0x923F82A4, 0xAB1C5ED5,
            0xD807AA98, 0x12835B01, 0x243185BE, 0x550C7DC3,
            0x72BE5D74, 0x80DEB1FE, 0x9BDC06A7, 0xC19BF174,
            0xE49B69C1, 0xEFBE4786, 0x0FC19DC6, 0x240CA1CC,
            0x2DE92C6F, 0x4A7484AA, 0x5CB0A9DC, 0x76F988DA,
            0x983E5152, 0xA831C66D, 0xB00327C8, 0xBF597FC7,
            0xC6E00BF3, 0xD5A79147, 0x06CA6351, 0x14292967,
            0x27B70A85, 0x2E1B2138, 0x4D2C6DFC, 0x53380D13,
            0x650A7354, 0x766A0ABB, 0x81C2C92E, 0x92722C85,
            0xA2BFE8A1, 0xA81A664B, 0xC24B8B70, 0xC76C51A3,
            0xD192E819, 0xD6990624, 0xF40E3585, 0x106AA070,
            0x19A4C116, 0x1E376C08, 0x2748774C, 0x34B0BCB5,
            0x391C0CB3, 0x4ED8AA4A, 0x5B9CCA4F, 0x682E6FF3,
            0x748F82EE, 0x78A5636F, 0x84C87814, 0x8CC70208,
            0x90BEFFFA, 0xA4506CEB, 0xBEF9A3F7, 0xC67178F2
        ]
    }

    // 填充规则同 SHA-1，但长度字段同样是 64 位大端比特数。
    static fn padded(data: Array) -> Array {
        let out = bbSlice(data, 0, len(data))
        let bitLen = len(data) * 8
        bbPut(out, 0x80)
        while (len(out) % 64) != 56 {
            bbPut(out, 0)
        }
        bbPutU32BE(out, (bitLen >> 32) & SHA256_MASK32)
        bbPutU32BE(out, bitLen & SHA256_MASK32)
        return out
    }

    static fn hash(data: Array) -> Array {
        var h0 = SHA256_H0
        var h1 = SHA256_H1
        var h2 = SHA256_H2
        var h3 = SHA256_H3
        var h4 = SHA256_H4
        var h5 = SHA256_H5
        var h6 = SHA256_H6
        var h7 = SHA256_H7

        let msg  = Sha256.padded(data)
        let kk   = Sha256.k()
        let total = len(msg)
        var off = 0

        while off < total {
            let w = []
            var t = 0
            while t < 16 {
                arrPush(w, bbU32BE(msg, off + t * 4) & SHA256_MASK32)
                t = t + 1
            }
            while t < 64 {
                let s0 = Sha256.rotr(toInt(w[t - 15]), 7)
                       ^ Sha256.rotr(toInt(w[t - 15]), 18)
                       ^ (toInt(w[t - 15]) >> 3)
                let s1 = Sha256.rotr(toInt(w[t - 2]), 17)
                       ^ Sha256.rotr(toInt(w[t - 2]), 19)
                       ^ (toInt(w[t - 2]) >> 10)
                let v = (toInt(w[t - 16]) + (s0 & SHA256_MASK32)
                       + toInt(w[t - 7]) + (s1 & SHA256_MASK32)) & SHA256_MASK32
                arrPush(w, v)
                t = t + 1
            }

            var a = h0
            var b = h1
            var c = h2
            var d = h3
            var e = h4
            var f = h5
            var g = h6
            var h = h7

            t = 0
            while t < 64 {
                let S1 = Sha256.rotr(e, 6) ^ Sha256.rotr(e, 11) ^ Sha256.rotr(e, 25)
                let ch = (e & f) ^ ((~e & SHA256_MASK32) & g)
                let t1 = (h + (S1 & SHA256_MASK32) + (ch & SHA256_MASK32)
                        + toInt(kk[t]) + toInt(w[t])) & SHA256_MASK32
                let S0 = Sha256.rotr(a, 2) ^ Sha256.rotr(a, 13) ^ Sha256.rotr(a, 22)
                let mj = (a & b) ^ (a & c) ^ (b & c)
                let t2 = ((S0 & SHA256_MASK32) + (mj & SHA256_MASK32)) & SHA256_MASK32

                h = g
                g = f
                f = e
                e = (d + t1) & SHA256_MASK32
                d = c
                c = b
                b = a
                a = (t1 + t2) & SHA256_MASK32
                t = t + 1
            }

            h0 = (h0 + a) & SHA256_MASK32
            h1 = (h1 + b) & SHA256_MASK32
            h2 = (h2 + c) & SHA256_MASK32
            h3 = (h3 + d) & SHA256_MASK32
            h4 = (h4 + e) & SHA256_MASK32
            h5 = (h5 + f) & SHA256_MASK32
            h6 = (h6 + g) & SHA256_MASK32
            h7 = (h7 + h) & SHA256_MASK32
            off = off + 64
        }

        let out = []
        bbPutU32BE(out, h0)
        bbPutU32BE(out, h1)
        bbPutU32BE(out, h2)
        bbPutU32BE(out, h3)
        bbPutU32BE(out, h4)
        bbPutU32BE(out, h5)
        bbPutU32BE(out, h6)
        bbPutU32BE(out, h7)
        return out
    }

    static fn hashText(s: String) -> Array {
        return Sha256.hash(bbFromUtf8(s))
    }

    static fn hexOf(b: Array) -> String {
        return Sha1.hexOf(b)
    }

    static fn hexText(s: String) -> String {
        return Sha1.hexOf(Sha256.hashText(s))
    }
}