// repository/post_repo.xle — 文章仓储（内存实现）
//
// ── 为什么仓储是一个抽象而不是直接接数据库 ───────────
//
// 因为「业务逻辑」和「存储实现」的变更频率完全不同：
//
//   业务逻辑：文章的校验规则、发布流程 —— 几个月改一次
//   存储实现：从内存换到 MySQL 换到 ES —— 一年可能换一次
//
// 混在一起的话，换存储时要在业务代码里翻找所有 SQL。分开之后，
// 只需换一个实现并保持接口不变。
//
// ── 为什么本示例是内存实现 ────────────────────
//
// 因为示例的目的是展示「分层结构」，不是展示数据库用法。用内存
// 实现能让示例在没有数据库的环境里直接跑起来 —— 而一个有外部
// 依赖的示例，有一半的人跑不起来，也就学不到东西。
//
// 真实项目的做法：保留这个接口，另写一个 `post_repo_mysql.xle`
// 实现同一组方法，在配置里切换。
//
// ── 本实现的并发安全说明 ────────────────────
//
// **不安全**。因为 HTTP 服务是单线程事件循环，同一时刻只有一个
// 请求在处理，所以不需要锁。如果以后改成多线程，这里必须加锁
// —— 而那时第一件事是把 nextId 的自增改成原子操作。

import "../model/post.xle"

class PostRepository {
    // 所有文章（按插入顺序）。数组下标 + 1 = id。
    //
    // ── 为什么不用「删除后移动元素」--- 
    //
    // 因为移动元素会让所有后续 id 变化，而外部引用（URL 里的 id）
    // 会失效。删除用「置为已删除」的方式（见 deleted 数组），
    // id 保持不变。
    posts: Array

    // 与 posts 平行：是否已删除。
    //
    // ── 为什么不直接把元素置 null ──────────────────
    //
    // 因为语言没有 null。用平行数组是唯一能表达「这里曾经有个元素
    // 但现在没了」的方式。
    deleted: Array

    // 下一个可用 id。
    nextId: Int

    constructor() {
        self.posts   = []
        self.deleted = []
        self.nextId  = 1
    }

    // ── 写 ────────────────────────────────────

    // 新建。返回入库后的 id。
    fn insert(p: Post) -> Int {
        p.id = self.nextId
        self.nextId = self.nextId + 1
        arrPush(self.posts, p)
        arrPush(self.deleted, false)
        return p.id
    }

    // 按 id 更新。返回 [ok, error]。
    fn update(p: Post) -> Array {
        let at = self.indexOf(p.id)
        if (at < 0) {
            return [false, "文章 #" + toString(p.id) + " 不存在或已删除"]
        }
        self.posts[at] = p
        return [true, ""]
    }

    // 按 id 删除（软删除）。返回 [ok, error]。
    fn remove(id: Int) -> Array {
        let at = self.indexOf(id)
        if (at < 0) {
            return [false, "文章 #" + toString(id) + " 不存在或已删除"]
        }
        self.deleted[at] = true
        return [true, ""]
    }

    // ── 读 ────────────────────────────────────

    // 按 id 查。找不到时返回 id = 0 的占位对象。
    fn findById(id: Int) -> Post {
        let at = self.indexOf(id)
        if (at < 0) { return new Post("", "", "") }
        let p: Post = self.posts[at]
        return p
    }

    // 是否存在。
    fn exists(id: Int) -> Bool {
        return self.indexOf(id) >= 0
    }

    // 全部未删除的文章。
    fn findAll() -> Array {
        let out = []
        var i = 0
        while i < len(self.posts) {
            let gone: Bool = self.deleted[i]
            if (!gone) {
                arrPush(out, self.posts[i])
            }
            i = i + 1
        }
        return out
    }

    // 按状态过滤。
    fn findByStatus(status: String) -> Array {
        let out = []
        let all = self.findAll()
        var i = 0
        while i < len(all) {
            let p: Post = all[i]
            if (p.status == status) { arrPush(out, p) }
            i = i + 1
        }
        return out
    }

    // 按标签过滤。
    fn findByTag(tag: String) -> Array {
        let out = []
        let all = self.findAll()
        var i = 0
        while i < len(all) {
            let p: Post = all[i]
            if (postHasTag(p.tags, tag)) { arrPush(out, p) }
            i = i + 1
        }
        return out
    }

    // 分页。返回 [items, total]。
    //
    // ── 为什么返回 total 而不只是当前页 ────────────
    //
    // 因为客户端要算总页数。只给当前页的话，客户端只能「翻到空页
    // 才知道到底了」—— 而那会让「下一页」按钮永远可点，用户体验
    // 是点进去看到「暂无内容」。
    fn findPage(offset: Int, limit: Int) -> Array {
        let all = self.findAll()
        let out = []
        var i = offset
        var n = 0
        while i < len(all) && n < limit {
            if (i >= 0) {
                arrPush(out, all[i])
                n = n + 1
            }
            i = i + 1
        }
        return [out, len(all)]
    }

    fn count() -> Int {
        return len(self.findAll())
    }

    // ── 内部 ──────────────────────────────────

    // 找 id 对应的下标，跳过已删除的。找不到返回 -1。
    fn indexOf(id: Int) -> Int {
        var i = 0
        while i < len(self.posts) {
            let p: Post = self.posts[i]
            if (p.id == id) {
                let gone: Bool = self.deleted[i]
                if (!gone) { return i }
                return 0 - 1
            }
            i = i + 1
        }
        return 0 - 1
    }

    fn describe() -> String {
        return "PostRepository(" + toString(self.count()) + " 未删除 / " +
               toString(len(self.posts)) + " 总计, nextId=" + toString(self.nextId) + ")"
    }
}

// 文章的标签里是否含某个标签。
fn postHasTag(tags: Array, tag: String) -> Bool {
    var i = 0
    while i < len(tags) {
        let t: String = tags[i]
        if (t == tag) { return true }
        i = i + 1
    }
    return false
}