// 19-for-continue.xla —— `for` + `continue` + `else if` 的回归测试
//
// ── 这个测试为什么必须存在 ──────────────────────────────────
//
// 它测的三件事单独看都没问题，组合起来曾经让编译器**段错误**，
// 而且是非确定性的（同一份源码反复编译，有时崩有时不崩）。
// 那种 bug 如果没有回归测试，下次改 parser 时很容易原样复活，
// 而届时又要从「一行输出都没有 + 退出码 139」重新查一遍。
//
// 三个具体的历史 bug：
//
// 1) `for` 里的 `continue` 跳过递增 → 死循环、不报错、不崩溃。
//    修法：parser 层把递增语句物理复制到每个 continue 前面。
//
// 2) `for` 里的 `else if` → 段错误。
//    根因：ST_IF 的 else_body 在 `else if` 时是 ST_IF 而不是 ST_BLOCK，
//    而注入逻辑无条件下读 `->block.stmts` / `->block.count` —— 把
//    union 里的 Expr* 当 Stmt** 用、把 Stmt* 当 int 当长度用。
//    病征是「指针当长度、指针当数组」，崩在什么地址取决于堆布局。
//
// 3) 内层 for 的 continue 不能被内层处理时误插外层递增。
//    这一条是「递归遇到 ST_WHILE 就停」的判据，测法是对照内外两层
//    各自的期望值。

fn main() -> Int {
    // ============================================================
    // 一、最基本的 for + continue
    // ============================================================
    // 只累加偶数：0 2 4 6 8 → 20
    var s1 = 0
    for i in 0..10 {
        if i % 2 == 1 { continue }
        s1 += i
    }
    println(s1)                     // 20

    // ============================================================
    // 二、for + continue + else if（历史 bug 2 的直接复现）
    // ============================================================
    // 计算 0..12 里「能被 3 整除」的和，但跳过 6：
    //   3 + 9 + 12 = 24，0 不影响，6 被跳过
    var s2 = 0
    for i in 0..13 {
        if i % 3 != 0 {
            continue
        } else if i == 6 {
            continue
        }
        s2 += i
    }
    println(s2)                     // 24

    // else if 链上还有更长的分支，确保递归深度不止一层
    var s3 = 0
    for i in 0..10 {
        if i == 0 {
            continue
        } else if i == 1 {
            continue
        } else if i == 2 {
            continue
        } else if i == 3 {
            s3 += 100
        } else {
            s3 += i
        }
    }
    println(s3)                     // 100 + 4+5+6+7+8+9 = 139

    // ============================================================
    // 三、嵌套 for + continue（历史 bug 1 与 3 的交叉）
    // ============================================================
    // 外层跳过奇数行，内层跳过奇数列，统计保留的格子数：
    //   外层保留 0 2 4 6 8（5 个），内层保留 0 2 4 6 8（5 个）→ 25
    var n4 = 0
    for y in 0..10 {
        if y % 2 == 1 { continue }
        for x in 0..10 {
            if x % 2 == 1 { continue }
            n4 += 1
        }
    }
    println(n4)                     // 25

    // 内层累计、外层 continue：内层那 25 次累加必须都发生在
    // 「外层没 continue」的 5 个行上。若注入逻辑把内层的递增
    // 插到了外层 continue 前面，这里会算出离谱的数。
    var s5 = 0
    for y in 0..10 {
        if y % 2 == 1 { continue }
        for x in 0..10 {
            if x % 2 == 1 { continue }
            s5 += y * 10 + x
        }
    }
    println(s5)                     // 0+2+4+6+8 行，每行 0+2+4+6+8 列
                                    // = (0+2+4+6+8) * 10 * 5 + (0+2+4+6+8) * 5
                                    // = 20*50 + 20*5 = 1000 + 100 = 1100

    // ============================================================
    // 四、for 里的 continue 之后如果什么都不剩
    // ============================================================
    // 整个循环体只有 continue：`for i in 0..5 { continue }`
    // 必须能正常跑完 5 次而不是卡死。用一个计数器证明它终止了。
    var n6 = 0
    for i in 0..5 {
        continue
    }
    n6 = 1
    println(n6)                     // 1

    // ============================================================
    // 五、`for x in 数组` 形式 + continue
    // ============================================================
    // 数组遍历分支也会注入递增，同样要测。
    let arr = array(6, 0)
    arr[0] = 10
    arr[1] = 20
    arr[2] = 30
    arr[3] = 40
    arr[4] = 50
    arr[5] = 60
    var s7 = 0
    for v in arr {
        if v > 40 { continue }
        s7 += v
    }
    println(s7)                     // 10+20+30+40 = 100

    // 数组遍历 + continue + else if
    var s8 = 0
    for v in arr {
        if v == 10 {
            continue
        } else if v == 30 {
            continue
        } else if v == 50 {
            s8 += 1000
        } else {
            s8 += v
        }
    }
    println(s8)                     // 1000 + 20+40+60 = 1120

    // ============================================================
    // 六、for 里的 continue 配合 while（continue 必须归属正确的层）
    // ============================================================
    // 外层 for，内层 while。内层 while 的 continue 不能触发
    // 外层 for 的递增注入（否则下标乱跳）。
    var s9 = 0
    for i in 0..4 {
        var j = 0
        while j < 4 {
            j += 1
            if j == 2 { continue }
            s9 += 1
        }
    }
    println(s9)                     // 每轮 3 次（j=1,3,4）→ 12

    println("for-continue ok")
    return 0
}