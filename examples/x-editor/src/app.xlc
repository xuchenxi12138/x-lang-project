// ============================================================
// Notepad X —— 用 X 语言中文模块写的文本编辑器
// ============================================================
//
// 界面参照 Notepad++：菜单栏 / 工具栏 / 多标签 / 行号 / 语法高亮 /
// 查找替换 / 状态栏 / 深色与浅色主题。
//
// 应用只使用 @zh 提供的中文类型、函数、常量与窗口接口。
// 英文标准库对象和平台内建全部留在中文依赖层内部。

从 @zh 引入 文档, 代码视图, 矩形, 主题, 菜单栏, 菜单, 工具栏, 标签条, 状态栏, 输入框, 按钮
从 @zh 引入 转字符串, 转整数, 长度, 追加, 移除, 拼接
从 @zh 引入 读文件或, 深度写, 取文件名, 存在吗, 是整数样
从 @zh 引入 查找, 开头是, 取子串, 打印行
从 @zh 引入 查找下一个, 查找上一个, 替换一处, 替换全部
从 @zh 引入 语言纯文本, 语言自研, 语言蟒蛇, 语言配置, 语言标记, 语言网页, 语言数据
从 @zh 引入 语言名, 语言自路径, 换行名
从 @zh 引入 键码, 键字符, 键修饰, 按控制, 按上档, 按交替
从 @zh 引入 键退格, 键制表, 键回车, 键退出, 键上页, 键下页, 键末尾, 键开头
从 @zh 引入 键左, 键上, 键右, 键下, 键删除, 键功能3, 键零
从 @zh 引入 键全选, 键复制, 键复制行, 键查找, 键跳转, 键替换, 键删除行
从 @zh 引入 键新建, 键打开, 键注释, 键保存, 键大写, 键粘贴, 键关闭, 键剪切, 键重做, 键撤销
从 @zh 引入 键主键盘加, 键主键盘减, 键小键盘加, 键小键盘减
从 @zh 引入 菜单文字, 左写文字
从 @zh 引入 设窗口可缩放, 打开窗口, 关闭窗口, 窗口应关闭, 窗口宽度, 窗口高度, 设窗口标题
从 @zh 引入 设窗口字体, 取点击事件, 取按键事件, 取滚轮, 鼠标横, 鼠标纵
从 @zh 引入 开始帧, 结束帧, 窗口暂停, 填充矩形, 窗口截图, 消息框
从 @zh 引入 打开文件对话框, 保存文件对话框, 写剪贴板, 读剪贴板

// ── 布局常量 ─────────────────────────────────
常 菜单高 = 28
常 工具高 = 36
常 状态高 = 24
常 查找高 = 36
常 替换高 = 72

// ============================================================
// 应用
// ============================================================

类 编辑器应用 {
    文档们: 数组,
    视图们: 数组,
    当前: 整数,
    主题: 主题,
    深色: 布尔,
    字号: 整数,
    新建计数: 整数,

    菜单栏: 菜单栏,
    菜单: 菜单,
    菜单号: 整数,
    工具: 工具栏,
    标签条: 标签条,
    状态: 状态栏,

    查找条: 布尔,
    替换条: 布尔,
    跳转条: 布尔,
    焦点: 整数,          // 0=编辑区 1=查找 2=替换 3=跳转
    查找框: 输入框,
    替换框: 输入框,
    跳转框: 输入框,
    按钮上一个: 按钮,
    按钮下一个: 按钮,
    按钮关闭: 按钮,
    按钮替换: 按钮,
    按钮全部替换: 按钮,
    按钮区分: 按钮,
    按钮全词: 按钮,
    按钮循环: 按钮,
    按钮跳转: 按钮,
    按钮关闭跳转: 按钮,

    区分大小写: 布尔,
    全词: 布尔,
    允许循环: 布尔,

    窗口宽: 整数,
    窗口高: 整数,
    运行中: 布尔,

    构造() {
        自身.文档们 = []
        自身.视图们 = []
        自身.当前 = 0
        自身.主题 = 主题.深色()
        自身.深色 = 真
        自身.字号 = 16
        自身.新建计数 = 1
        自身.菜单号 = -1
        自身.查找条 = 假
        自身.替换条 = 假
        自身.跳转条 = 假
        自身.焦点 = 0
        自身.运行中 = 真
        自身.窗口宽 = 1120
        自身.窗口高 = 720

        自身.菜单栏 = 新建 菜单栏(新建 矩形(0, 0, 1120, 菜单高),
            ["文件", "编辑", "搜索", "视图", "语言", "设置", "帮助"])
        自身.菜单 = 新建 菜单([])
        自身.工具 = 新建 工具栏(新建 矩形(0, 菜单高, 1120, 工具高),
            ["新建", "打开", "保存", "全部保存", "|", "剪切", "复制", "粘贴", "|",
             "撤销", "重做", "|", "查找", "替换", "|", "注释", "大写", "小写", "|", ">深色"])
        自身.标签条 = 新建 标签条(新建 矩形(0, 菜单高 + 工具高, 1120, 400), ["新建 1"])
        自身.状态 = 新建 状态栏(新建 矩形(0, 720 - 状态高, 1120, 状态高))

        自身.查找框 = 新建 输入框(新建 矩形(0, 0, 240, 24))
        自身.查找框.设占位("查找内容")
        自身.替换框 = 新建 输入框(新建 矩形(0, 0, 240, 24))
        自身.替换框.设占位("替换为")
        自身.跳转框 = 新建 输入框(新建 矩形(0, 0, 100, 24))
        自身.跳转框.设占位("行号")

        自身.按钮上一个 = 按钮.透明(新建 矩形(0, 0, 64, 24), "上一个")
        自身.按钮下一个 = 按钮.透明(新建 矩形(0, 0, 64, 24), "下一个")
        自身.按钮关闭 = 按钮.透明(新建 矩形(0, 0, 28, 24), "×")
        自身.按钮替换 = 按钮.次要(新建 矩形(0, 0, 64, 24), "替换")
        自身.按钮全部替换 = 按钮.次要(新建 矩形(0, 0, 80, 24), "全部替换")
        自身.按钮区分 = 按钮.透明(新建 矩形(0, 0, 96, 24), "区分大小写")
        自身.按钮全词 = 按钮.透明(新建 矩形(0, 0, 56, 24), "全词")
        自身.按钮循环 = 按钮.透明(新建 矩形(0, 0, 56, 24), "循环")
        自身.按钮跳转 = 按钮.主要(新建 矩形(0, 0, 60, 24), "跳转")
        自身.按钮关闭跳转 = 按钮.透明(新建 矩形(0, 0, 28, 24), "×")

        自身.区分大小写 = 假
        自身.全词 = 假
        自身.允许循环 = 真
        自身.同步开关()

        自身.新文档()
    }

    // 三个开关按钮的视觉跟随布尔值：开 = 主色，关 = 透明。
    函 同步开关() {
        自身.按钮区分.设主要(自身.区分大小写)
        自身.按钮全词.设主要(自身.全词)
        自身.按钮循环.设主要(自身.允许循环)
    }

    // ── 文档管理 ─────────────────────────────

    函 新文档() {
        令 新档 = 新建 文档()
        新档.设名称("新建 " + 转字符串(自身.新建计数))
        自身.新建计数 = 自身.新建计数 + 1
        令 新视图 = 新建 代码视图(新建 矩形(0, 200, 800, 500), 新档)
        新视图.设状态([0])
        追加(自身.文档们, 新档)
        追加(自身.视图们, 新视图)
        自身.当前 = 长度(自身.文档们) - 1
        自身.焦点 = 0
    }

    函 当前文档() -> 文档 {
        令 文档对象: 文档 = 自身.文档们[自身.当前]
        返回 文档对象
    }

    函 当前视图() -> 代码视图 {
        令 视图对象: 代码视图 = 自身.视图们[自身.当前]
        返回 视图对象
    }

    函 语言数() -> 整数 {
        返回 8
    }

    // 扩展名 → 语言编号。
    函 探测语言(路径: 字符串) -> 整数 {
        返回 语言自路径(路径)
    }

    // 按语言给出注释前缀/后缀。空串表示该语言没有行注释。
    函 注释标记(语言编号: 整数) -> 数组 {
        如果 (语言编号 == 语言蟒蛇)   { 返回 ["# ", ""] }
        如果 (语言编号 == 语言配置)  { 返回 ["; ", ""] }
        如果 (语言编号 == 语言标记)   { 返回 ["# ", ""] }
        如果 (语言编号 == 语言网页) { 返回 ["<!-- ", " -->"] }
        如果 (语言编号 == 语言数据) { 返回 ["", ""] }
        返回 ["// ", ""]
    }

    函 应用语言() {
        令 文档对象: 文档 = 自身.文档们[自身.当前]
        如果 (文档对象.语言() < 0 || 文档对象.语言() >= 自身.语言数()) {
            文档对象.设语言(语言纯文本)
        }
        令 视图对象: 代码视图 = 自身.视图们[自身.当前]
        视图对象.设状态([0])
        视图对象.设滚动(0, 0)
    }

    函 同步视图() {
        令 视图对象: 代码视图 = 自身.视图们[自身.当前]
        令 文档对象: 文档 = 自身.文档们[自身.当前]
        视图对象.设文档(文档对象)
        视图对象.设滚动(0, 0)
        视图对象.更新行号宽()
        自身.应用语言()
    }

    函 打开路径(路径: 字符串) {
        如果 (长度(路径) == 0) { 返回 }
        令 序号 = 0
        当 (序号 < 长度(自身.文档们)) {
            令 文档对象: 文档 = 自身.文档们[序号]
            如果 (文档对象.路径() == 路径) {
                自身.当前 = 序号
                自身.同步视图()
                返回
            }
            序号 = 序号 + 1
        }
        如果 (!存在吗(路径)) {
            消息框("打开失败", "文件不存在：\n" + 路径, 0)
            返回
        }
        令 文本 = 读文件或(路径, "")
        令 新档 = 新建 文档()
        新档.设文本(文本)
        新档.设路径(路径)
        新档.设名称(取文件名(路径))
        如果 (查找(文本, "\r\n") >= 0) { 新档.设换行方式(0) }
        否则 { 如果 (查找(文本, "\r") >= 0) { 新档.设换行方式(2) } 否则 { 新档.设换行方式(1) } }
        新档.设语言(自身.探测语言(路径))
        新档.设已修改(假)
        令 新视图 = 新建 代码视图(新建 矩形(0, 200, 800, 500), 新档)
        追加(自身.文档们, 新档)
        追加(自身.视图们, 新视图)
        自身.当前 = 长度(自身.文档们) - 1
        自身.同步视图()
    }

    函 保存文档(另存: 布尔) -> 布尔 {
        令 文档对象: 文档 = 自身.文档们[自身.当前]
        变 路径 = 文档对象.路径()
        如果 (另存 || 长度(路径) == 0) {
            路径 = 保存文件对话框("保存文件", "文本文件 (*.txt)|*.txt|所有文件 (*.*)|*.*", 路径)
            如果 (长度(路径) == 0) { 返回 假 }
        }
        令 成功 = 深度写(路径, 文档对象.文本())
        如果 (!成功) {
            消息框("保存失败", "无法写入：\n" + 路径, 0)
            返回 假
        }
        文档对象.设路径(路径)
        文档对象.设名称(取文件名(路径))
        文档对象.设已修改(假)
        如果 (文档对象.语言() == 语言纯文本) {
            文档对象.设语言(自身.探测语言(路径))
            自身.应用语言()
        }
        返回 真
    }

    函 全部保存() {
        令 序号 = 0
        当 (序号 < 长度(自身.文档们)) {
            令 文档对象: 文档 = 自身.文档们[序号]
            如果 (文档对象.已修改()) {
                自身.当前 = 序号
                如果 (!自身.保存文档(假)) { 返回 }
            }
            序号 = 序号 + 1
        }
    }

    函 关闭当前() -> 布尔 {
        令 文档对象: 文档 = 自身.文档们[自身.当前]
        如果 (文档对象.已修改()) {
            令 结果 = 消息框("Notepad X", "“" + 文档对象.标题() + "” 已修改，是否保存？", 2)
            如果 (结果 < 0) { 返回 假 }
            如果 (结果 == 1) {
                如果 (!自身.保存文档(假)) { 返回 假 }
            }
        }
        移除(自身.文档们, 自身.当前)
        移除(自身.视图们, 自身.当前)
        如果 (长度(自身.文档们) == 0) { 自身.新文档() }
        如果 (自身.当前 >= 长度(自身.文档们)) { 自身.当前 = 长度(自身.文档们) - 1 }
        自身.同步视图()
        返回 真
    }

    函 退出() {
        令 序号 = 0
        当 (序号 < 长度(自身.文档们)) {
            令 文档对象: 文档 = 自身.文档们[序号]
            如果 (文档对象.已修改()) {
                自身.当前 = 序号
                令 结果 = 消息框("Notepad X", "“" + 文档对象.标题() + "” 已修改，是否保存？", 2)
                如果 (结果 < 0) { 返回 }
                如果 (结果 == 1) {
                    如果 (!自身.保存文档(假)) { 返回 }
                }
            }
            序号 = 序号 + 1
        }
        自身.运行中 = 假
    }

    // ── 菜单内容 ─────────────────────────────

    函 菜单项(序号: 整数) -> 数组 {
        如果 (序号 == 0) {
            返回 ["新建  Ctrl+N", "打开...  Ctrl+O", "-", "保存  Ctrl+S", "另存为...  Ctrl+Shift+S",
                  "全部保存", "-", "关闭  Ctrl+W", "退出"]
        }
        如果 (序号 == 1) {
            返回 ["撤销  Ctrl+Z", "重做  Ctrl+Y", "-", "剪切  Ctrl+X", "复制  Ctrl+C", "粘贴  Ctrl+V",
                  "删除  Del", "-", "全选  Ctrl+A", "复制当前行  Ctrl+D", "删除当前行  Ctrl+L", "-",
                  "转换为大写  Ctrl+Shift+U", "转换为小写  Ctrl+Shift+L", "-",
                  "注释/取消注释  Ctrl+Q", "缩进  Tab", "减少缩进  Shift+Tab", "-",
                  "排序选中行", "删除行尾空白"]
        }
        如果 (序号 == 2) {
            返回 ["查找...  Ctrl+F", "替换...  Ctrl+H", "-", "查找下一个  F3", "查找上一个  Shift+F3",
                  "-", "转到行...  Ctrl+G"]
        }
        如果 (序号 == 3) {
            返回 ["!自动换行（后续版本）", "显示行号", "-", "放大  Ctrl+=", "缩小  Ctrl+-",
                  "重置缩放", "-", "深色主题", "浅色主题"]
        }
        如果 (序号 == 4) {
            返回 自身.语言菜单()
        }
        如果 (序号 == 5) {
            返回 ["行尾符：Windows (CRLF)", "行尾符：Unix (LF)", "行尾符：Macintosh (CR)", "-", "重置缩放"]
        }
        返回 ["快捷键说明", "关于 Notepad X"]
    }

    函 语言菜单() -> 数组 {
        令 文档对象: 文档 = 自身.文档们[自身.当前]
        令 输出 = []
        令 序号 = 0
        当 (序号 < 自身.语言数()) {
            变 标签 = 语言名(序号)
            如果 (文档对象.语言() == 序号) { 标签 = "● " + 标签 }
            追加(输出, 标签)
            序号 = 序号 + 1
        }
        返回 输出
    }

    函 设置语言(标签: 字符串) -> 布尔 {
        变 文字 = 标签
        如果 (开头是(文字, "● ")) { 文字 = 取子串(文字, 2, 长度(文字)) }
        令 序号 = 0
        当 (序号 < 自身.语言数()) {
            如果 (语言名(序号) == 文字) {
                令 文档对象: 文档 = 自身.文档们[自身.当前]
                文档对象.设语言(序号)
                自身.应用语言()
                返回 真
            }
            序号 = 序号 + 1
        }
        返回 假
    }

    函 打开菜单(序号: 整数) {
        自身.菜单号 = 序号
        自身.菜单栏.设打开序号(序号)
        自身.菜单.设项目(自身.菜单项(序号))
        令 项区域: 矩形 = 自身.菜单栏.项区域(序号)
        自身.菜单.打开于(项区域.横(), 菜单高)
    }

    函 关闭菜单() {
        自身.菜单号 = -1
        自身.菜单栏.设打开序号(-1)
        自身.菜单.关闭()
    }

    // ── 命令分发 ─────────────────────────────

    函 执行(命令: 字符串) {
        令 文档对象: 文档 = 自身.文档们[自身.当前]
        令 视图对象: 代码视图 = 自身.视图们[自身.当前]

        如果 (命令 == "新建") { 自身.新文档(); 返回 }
        如果 (命令 == "打开...") {
            令 路径 = 打开文件对话框("打开文件",
                "文本文件 (*.txt;*.c;*.cpp;*.h;*.py;*.js;*.ts;*.java;*.cs;*.go;*.rs;*.xle;*.xlc;*.md)|*.txt;*.c;*.cpp;*.h;*.py;*.js;*.ts;*.java;*.cs;*.go;*.rs;*.xle;*.xlc;*.md|所有文件 (*.*)|*.*",
                "")
            自身.打开路径(路径)
            返回
        }
        如果 (命令 == "保存") { 自身.保存文档(假); 返回 }
        如果 (命令 == "另存为...") { 自身.保存文档(真); 返回 }
        如果 (命令 == "全部保存") { 自身.全部保存(); 返回 }
        如果 (命令 == "关闭") { 自身.关闭当前(); 返回 }
        如果 (命令 == "退出") { 自身.退出(); 返回 }

        如果 (命令 == "撤销") { 文档对象.撤销(); 返回 }
        如果 (命令 == "重做") { 文档对象.重做(); 返回 }
        如果 (命令 == "剪切") { 自身.剪切(); 返回 }
        如果 (命令 == "复制") { 自身.复制(); 返回 }
        如果 (命令 == "粘贴") { 自身.粘贴(); 返回 }
        如果 (命令 == "删除") { 自身.删除选区(); 返回 }
        如果 (命令 == "全选") { 文档对象.全选(); 返回 }
        如果 (命令 == "复制当前行") { 文档对象.复制当前行(); 返回 }
        如果 (命令 == "删除当前行") { 文档对象.删除当前行(); 返回 }
        如果 (命令 == "转换为大写") { 文档对象.选区转大写(); 返回 }
        如果 (命令 == "转换为小写") { 文档对象.选区转小写(); 返回 }
        如果 (命令 == "注释/取消注释") {
            令 标记 = 自身.注释标记(文档对象.语言())
            文档对象.切换注释(转字符串(标记[0]), 转字符串(标记[1]))
            返回
        }
        如果 (命令 == "缩进") { 文档对象.缩进(); 返回 }
        如果 (命令 == "减少缩进") { 文档对象.减少缩进(); 返回 }
        如果 (命令 == "排序选中行") { 文档对象.排序选中行(); 返回 }
        如果 (命令 == "删除行尾空白") { 文档对象.删除行尾空白(); 返回 }

        如果 (命令 == "查找...") { 自身.打开查找(假); 返回 }
        如果 (命令 == "替换...") { 自身.打开查找(真); 返回 }
        如果 (命令 == "查找下一个") { 自身.查找下一个(); 返回 }
        如果 (命令 == "查找上一个") { 自身.查找上一个(); 返回 }
        如果 (命令 == "转到行...") { 自身.打开跳转(); 返回 }

        如果 (命令 == "显示行号") {
            视图对象.切换行号()
            返回
        }
        如果 (命令 == "放大") { 自身.缩放(1); 返回 }
        如果 (命令 == "缩小") { 自身.缩放(-1); 返回 }
        如果 (命令 == "重置缩放") { 自身.缩放(0); 返回 }
        如果 (命令 == "深色主题") { 自身.深色 = 真; 自身.主题 = 主题.深色(); 返回 }
        如果 (命令 == "浅色主题") { 自身.深色 = 假; 自身.主题 = 主题.浅色(); 返回 }
        如果 (命令 == "行尾符：Windows (CRLF)") { 文档对象.转换换行(0); 返回 }
        如果 (命令 == "行尾符：Unix (LF)") { 文档对象.转换换行(1); 返回 }
        如果 (命令 == "行尾符：Macintosh (CR)") { 文档对象.转换换行(2); 返回 }

        如果 (命令 == "快捷键说明") {
            消息框("快捷键",
                "Ctrl+N 新建      Ctrl+O 打开      Ctrl+S 保存\n" +
                "Ctrl+Z 撤销      Ctrl+Y 重做      Ctrl+A 全选\n" +
                "Ctrl+F 查找      Ctrl+H 替换      Ctrl+G 转到行\n" +
                "F3 下一个        Shift+F3 上一个\n" +
                "Ctrl+D 复制行    Ctrl+L 删除行    Ctrl+Q 注释\n" +
                "Ctrl+= 放大      Ctrl+- 缩小      Ctrl+W 关闭标签", 0)
            返回
        }
        如果 (命令 == "关于 Notepad X") {
            消息框("关于",
                "Notepad X\n用 X 语言中文模块编写的文本编辑器\n" +
                "组件来自中文依赖层", 0)
            返回
        }
    }

    函 缩放(方向: 整数) {
        如果 (方向 == 0) { 自身.字号 = 16 }
        否则 { 自身.字号 = 自身.字号 + 方向 }
        如果 (自身.字号 < 10) { 自身.字号 = 10 }
        如果 (自身.字号 > 32) { 自身.字号 = 32 }
        设窗口字体("Consolas", 自身.字号, 0)
    }

    // ── 编辑动作 ─────────────────────────────

    函 复制() {
        令 文档对象: 文档 = 自身.文档们[自身.当前]
        如果 (文档对象.有选区()) {
            写剪贴板(文档对象.选中文本())
        } 否则 {
            写剪贴板(文档对象.行内容(文档对象.光标行()) + "\n")
        }
    }

    函 剪切() {
        令 文档对象: 文档 = 自身.文档们[自身.当前]
        如果 (文档对象.有选区()) {
            写剪贴板(文档对象.选中文本())
            文档对象.编辑前()
            文档对象.静默删选区()
        } 否则 {
            写剪贴板(文档对象.行内容(文档对象.光标行()) + "\n")
            文档对象.删除当前行()
        }
    }

    函 粘贴() {
        令 文档对象: 文档 = 自身.文档们[自身.当前]
        令 文本 = 读剪贴板()
        如果 (长度(文本) > 0) { 文档对象.插入文本(文本) }
    }

    函 删除选区() {
        令 文档对象: 文档 = 自身.文档们[自身.当前]
        如果 (文档对象.有选区()) {
            文档对象.编辑前()
            文档对象.静默删选区()
        } 否则 {
            文档对象.向后删除()
        }
    }

    // ── 查找 / 替换 ───────────────────────────

    函 打开查找(替换: 布尔) {
        自身.查找条 = 真
        自身.替换条 = 替换
        自身.跳转条 = 假
        自身.焦点 = 1
        令 文档对象: 文档 = 自身.文档们[自身.当前]
        如果 (文档对象.有选区()) { 自身.查找框.设值(文档对象.选中文本()) }
    }

    函 关闭查找() {
        自身.查找条 = 假
        自身.替换条 = 假
        自身.跳转条 = 假
        自身.焦点 = 0
    }

    函 打开跳转() {
        自身.跳转条 = 真
        自身.查找条 = 假
        自身.替换条 = 假
        自身.焦点 = 3
        自身.跳转框.设值("")
    }

    函 查找下一个() {
        令 词 = 自身.查找词()
        如果 (长度(词) == 0) { 返回 }
        令 文档对象: 文档 = 自身.文档们[自身.当前]
        如果 (!查找下一个(文档对象, 词, 自身.区分大小写 ? 1 : 0, 自身.全词 ? 1 : 0, 自身.允许循环 ? 1 : 0)) {
            消息框("查找", "找不到：“" + 词 + "”", 0)
        }
    }

    函 查找上一个() {
        令 词 = 自身.查找词()
        如果 (长度(词) == 0) { 返回 }
        令 文档对象: 文档 = 自身.文档们[自身.当前]
        如果 (!查找上一个(文档对象, 词, 自身.区分大小写 ? 1 : 0, 自身.全词 ? 1 : 0, 自身.允许循环 ? 1 : 0)) {
            消息框("查找", "找不到：“" + 词 + "”", 0)
        }
    }

    // 查找词：输入框优先；面板关着时用当前选区，符合「选中即查」。
    函 查找词() -> 字符串 {
        令 词 = 自身.查找框.值文本()
        如果 (长度(词) > 0) { 返回 词 }
        令 文档对象: 文档 = 自身.文档们[自身.当前]
        如果 (文档对象.有选区()) {
            令 文本 = 文档对象.选中文本()
            如果 (查找(文本, "\n") < 0) { 返回 文本 }
        }
        返回 ""
    }

    函 替换当前() {
        令 文档对象: 文档 = 自身.文档们[自身.当前]
        令 词 = 自身.查找词()
        如果 (长度(词) == 0) { 返回 }
        如果 (替换一处(文档对象, 词, 自身.替换框.值文本(), 自身.区分大小写 ? 1 : 0, 自身.全词 ? 1 : 0)) {
            查找下一个(文档对象, 词, 自身.区分大小写 ? 1 : 0, 自身.全词 ? 1 : 0, 自身.允许循环 ? 1 : 0)
        } 否则 {
            消息框("替换", "当前没有匹配项，请先查找。", 0)
        }
    }

    函 全部替换() {
        令 文档对象: 文档 = 自身.文档们[自身.当前]
        令 词 = 自身.查找词()
        如果 (长度(词) == 0) { 返回 }
        令 数量 = 替换全部(文档对象, 词, 自身.替换框.值文本(), 自身.区分大小写 ? 1 : 0, 自身.全词 ? 1 : 0)
        消息框("替换", "已替换 " + 转字符串(数量) + " 处", 0)
    }

    函 跳转到行() {
        令 文本 = 自身.跳转框.值文本()
        变 行号 = 1
        如果 (是整数样(文本)) { 行号 = 转整数(文本) }
        令 文档对象: 文档 = 自身.文档们[自身.当前]
        文档对象.跳到行(行号)
        自身.关闭查找()
    }

    // ── 键盘 ─────────────────────────────────

    函 处理按键(事件: 数组) {
        令 键 = 键码(事件)
        令 字 = 键字符(事件)
        令 修饰 = 键修饰(事件)
        令 控制 = 按控制(修饰)
        令 上档 = 按上档(修饰)
        令 文档对象: 文档 = 自身.文档们[自身.当前]
        令 视图对象: 代码视图 = 自身.视图们[自身.当前]

        如果 (自身.焦点 > 0) {
            自身.输入框按键(键, 字, 修饰)
            返回
        }

        如果 (控制) {
            自身.控制键(键, 上档)
            返回
        }

        如果 (键 == 键退出) { 文档对象.清除选区(); 返回 }
        如果 (键 == 键回车) { 文档对象.换行(); 返回 }
        如果 (键 == 键制表) {
            如果 (上档) { 文档对象.减少缩进() } 否则 { 文档对象.缩进() }
            返回
        }
        如果 (键 == 键退格) { 文档对象.退格(); 返回 }
        如果 (键 == 键删除) { 文档对象.向后删除(); 返回 }
        如果 (键 == 键左) { 文档对象.左移(上档 ? 1 : 0); 返回 }
        如果 (键 == 键右) { 文档对象.右移(上档 ? 1 : 0); 返回 }
        如果 (键 == 键上) { 文档对象.上移(上档 ? 1 : 0); 返回 }
        如果 (键 == 键下) { 文档对象.下移(上档 ? 1 : 0); 返回 }
        如果 (键 == 键开头) { 文档对象.到行首(上档 ? 1 : 0); 返回 }
        如果 (键 == 键末尾) { 文档对象.到行尾(上档 ? 1 : 0); 返回 }
        如果 (键 == 键上页) { 文档对象.上页(视图对象.行数(), 上档 ? 1 : 0); 返回 }
        如果 (键 == 键下页) { 文档对象.下页(视图对象.行数(), 上档 ? 1 : 0); 返回 }
        如果 (键 == 键功能3) {
            如果 (上档) { 自身.查找上一个() } 否则 { 自身.查找下一个() }
            返回
        }

        如果 (字 != "" && !按交替(修饰)) {
            文档对象.插入文本(字)
        }
    }

    函 输入框按键(键: 整数, 字: 字符串, 修饰: 整数) {
        变 框: 输入框 = 自身.查找框
        如果 (自身.焦点 == 2) { 框 = 自身.替换框 }
        如果 (自身.焦点 == 3) { 框 = 自身.跳转框 }

        如果 (键 == 键退出) { 自身.关闭查找(); 返回 }
        如果 (键 == 键回车) {
            如果 (自身.焦点 == 3) { 自身.跳转到行(); 返回 }
            如果 (自身.焦点 == 2) { 自身.替换当前(); 返回 }
            自身.查找下一个()
            返回
        }
        如果 (键 == 键退格) { 框.退格(); 返回 }
        如果 (键 == 键删除) { 框.向后删除(); 返回 }
        如果 (键 == 键制表) {
            如果 (自身.替换条) {
                如果 (自身.焦点 == 1) { 自身.焦点 = 2 } 否则 { 自身.焦点 = 1 }
            }
            返回
        }
        如果 (字 != "" && !按控制(修饰) && !按交替(修饰)) {
            框.插入(字)
        }
    }

    函 控制键(键: 整数, 上档: 布尔) {
        令 文档对象: 文档 = 自身.文档们[自身.当前]
        如果 (键 == 键新建) { 自身.新文档(); 返回 }
        如果 (键 == 键打开) {
            令 路径 = 打开文件对话框("打开文件", "所有文件 (*.*)|*.*", "")
            自身.打开路径(路径)
            返回
        }
        如果 (键 == 键保存) {
            如果 (上档) { 自身.保存文档(真) } 否则 { 自身.保存文档(假) }
            返回
        }
        如果 (键 == 键关闭) { 自身.关闭当前(); 返回 }
        如果 (键 == 键撤销) {
            如果 (上档) { 文档对象.重做() } 否则 { 文档对象.撤销() }
            返回
        }
        如果 (键 == 键重做) { 文档对象.重做(); 返回 }
        如果 (键 == 键复制) { 自身.复制(); 返回 }
        如果 (键 == 键剪切) { 自身.剪切(); 返回 }
        如果 (键 == 键粘贴) { 自身.粘贴(); 返回 }
        如果 (键 == 键全选) { 文档对象.全选(); 返回 }
        如果 (键 == 键复制行) { 文档对象.复制当前行(); 返回 }
        如果 (键 == 键删除行) {
            如果 (上档) { 文档对象.选区转小写() } 否则 { 文档对象.删除当前行() }
            返回
        }
        如果 (键 == 键大写 && 上档) { 文档对象.选区转大写(); 返回 }
        如果 (键 == 键注释) {
            令 标记 = 自身.注释标记(文档对象.语言())
            文档对象.切换注释(转字符串(标记[0]), 转字符串(标记[1]))
            返回
        }
        如果 (键 == 键开头) { 文档对象.到文首(上档 ? 1 : 0); 返回 }
        如果 (键 == 键末尾) { 文档对象.到文末(上档 ? 1 : 0); 返回 }
        如果 (键 == 键查找) { 自身.打开查找(假); 返回 }
        如果 (键 == 键替换) { 自身.打开查找(真); 返回 }
        如果 (键 == 键跳转) { 自身.打开跳转(); 返回 }
        如果 (键 == 键主键盘加 || 键 == 键小键盘加) { 自身.缩放(1); 返回 }
        如果 (键 == 键主键盘减 || 键 == 键小键盘减) { 自身.缩放(-1); 返回 }
        如果 (键 == 键零) { 自身.缩放(0); 返回 }
        如果 (键 == 键制表) {
            如果 (长度(自身.文档们) > 1) {
                自身.当前 = (自身.当前 + 1) % 长度(自身.文档们)
                自身.同步视图()
            }
            返回
        }
    }

    // ── 鼠标 ─────────────────────────────────

    函 点(横: 整数, 纵: 整数) {
        如果 (自身.菜单号 >= 0) {
            令 菜单序号 = 自身.菜单.点击(横, 纵)
            如果 (菜单序号 >= 0) {
                令 标签 = 菜单文字(转字符串(自身.菜单.项目()[菜单序号]))
                如果 (自身.菜单号 == 4) {
                    自身.设置语言(标签)
                } 否则 {
                    自身.执行(标签)
                }
                自身.关闭菜单()
                返回
            }
            如果 (!自身.菜单.弹出区域().包含(横, 纵) && 自身.菜单栏.索引于(横, 纵) < 0) {
                自身.关闭菜单()
                返回
            }
        }

        令 顶部 = 自身.菜单栏.索引于(横, 纵)
        如果 (顶部 >= 0) {
            如果 (自身.菜单号 == 顶部) { 自身.关闭菜单() } 否则 { 自身.打开菜单(顶部) }
            返回
        }

        如果 (自身.查找条 || 自身.跳转条) {
            如果 (自身.按钮关闭.命中(横, 纵)) { 自身.关闭查找(); 返回 }
            如果 (自身.查找条) {
                如果 (自身.按钮上一个.命中(横, 纵)) { 自身.查找上一个(); 返回 }
                如果 (自身.按钮下一个.命中(横, 纵)) { 自身.查找下一个(); 返回 }
                如果 (自身.按钮区分.命中(横, 纵)) {
                    自身.区分大小写 = !自身.区分大小写
                    自身.同步开关()
                    返回
                }
                如果 (自身.按钮全词.命中(横, 纵)) {
                    自身.全词 = !自身.全词
                    自身.同步开关()
                    返回
                }
                如果 (自身.按钮循环.命中(横, 纵)) {
                    自身.允许循环 = !自身.允许循环
                    自身.同步开关()
                    返回
                }
                如果 (自身.替换条 && 自身.按钮替换.命中(横, 纵)) { 自身.替换当前(); 返回 }
                如果 (自身.替换条 && 自身.按钮全部替换.命中(横, 纵)) { 自身.全部替换(); 返回 }
                如果 (自身.查找框.命中(横, 纵)) {
                    自身.焦点 = 1
                    自身.查找框.点击于(横, 纵, 假)
                    返回
                }
                如果 (自身.替换条 && 自身.替换框.命中(横, 纵)) {
                    自身.焦点 = 2
                    自身.替换框.点击于(横, 纵, 假)
                    返回
                }
            }
            如果 (自身.跳转条) {
                如果 (自身.按钮跳转.命中(横, 纵)) { 自身.跳转到行(); 返回 }
                如果 (自身.按钮关闭跳转.命中(横, 纵)) { 自身.关闭查找(); 返回 }
                如果 (自身.跳转框.命中(横, 纵)) {
                    自身.焦点 = 3
                    自身.跳转框.点击于(横, 纵, 假)
                    返回
                }
            }
        }

        令 工具序号 = 自身.工具.点击(横, 纵)
        如果 (工具序号 >= 0) {
            令 名 = 自身.工具.项文字(转字符串(自身.工具.项目()[工具序号]))
            如果 (名 == "深色") {
                如果 (自身.深色) { 自身.执行("浅色主题") } 否则 { 自身.执行("深色主题") }
            } 否则 {
                自身.执行(名)
            }
            返回
        }

        如果 (自身.标签条.点击(横, 纵)) {
            自身.当前 = 自身.标签条.当前()
            自身.同步视图()
            返回
        }

        令 视图对象: 代码视图 = 自身.视图们[自身.当前]
        如果 (视图对象.按下(横, 纵)) {
            自身.焦点 = 0
        }
    }

    函 处理拖动() {
        如果 (自身.焦点 == 0) {
            令 视图对象: 代码视图 = 自身.视图们[自身.当前]
            视图对象.拖动(鼠标横(), 鼠标纵())
        }
    }

    // ── 布局与绘制 ───────────────────────────

    函 布局(宽: 整数, 高: 整数) {
        自身.窗口宽 = 宽
        自身.窗口高 = 高
        自身.菜单栏.设区域(新建 矩形(0, 0, 宽, 菜单高))
        自身.工具.设区域(新建 矩形(0, 菜单高, 宽, 工具高))

        变 底 = 高 - 状态高
        变 查找区 = 0
        如果 (自身.查找条) {
            如果 (自身.替换条) { 查找区 = 替换高 } 否则 { 查找区 = 查找高 }
        }
        如果 (自身.跳转条) { 查找区 = 查找高 }

        令 标签顶 = 菜单高 + 工具高
        自身.标签条.设区域(新建 矩形(0, 标签顶, 宽, 底 - 查找区 - 标签顶))
        令 内容区: 矩形 = 自身.标签条.内容区域()
        令 视图对象: 代码视图 = 自身.视图们[自身.当前]
        视图对象.设区域(内容区)
        视图对象.确保可见()

        令 查找顶 = 底 - 查找区 + 4
        自身.查找框.设区域(新建 矩形(84, 查找顶, 240, 24))
        自身.替换框.设区域(新建 矩形(84, 查找顶 + 32, 240, 24))
        自身.按钮上一个.设区域(新建 矩形(336, 查找顶, 72, 24))
        自身.按钮下一个.设区域(新建 矩形(412, 查找顶, 72, 24))
        自身.按钮关闭.设区域(新建 矩形(490, 查找顶, 28, 24))
        自身.按钮替换.设区域(新建 矩形(336, 查找顶 + 32, 72, 24))
        自身.按钮全部替换.设区域(新建 矩形(412, 查找顶 + 32, 88, 24))
        自身.按钮区分.设区域(新建 矩形(528, 查找顶, 96, 24))
        自身.按钮全词.设区域(新建 矩形(628, 查找顶, 56, 24))
        自身.按钮循环.设区域(新建 矩形(688, 查找顶, 56, 24))
        自身.跳转框.设区域(新建 矩形(84, 查找顶, 100, 24))
        自身.按钮跳转.设区域(新建 矩形(192, 查找顶, 60, 24))
        自身.按钮关闭跳转.设区域(新建 矩形(258, 查找顶, 28, 24))

        自身.状态.设区域(新建 矩形(0, 高 - 状态高, 宽, 状态高))

        令 名们 = []
        令 序号 = 0
        当 (序号 < 长度(自身.文档们)) {
            令 文档对象: 文档 = 自身.文档们[序号]
            变 名 = 文档对象.标题()
            如果 (文档对象.已修改()) { 名 = "● " + 名 }
            追加(名们, 名)
            序号 = 序号 + 1
        }
        自身.标签条.设标签(名们)
        自身.标签条.设选中(自身.当前)
    }

    函 画(宽: 整数, 高: 整数) {
        令 配色 = 自身.主题
        填充矩形(0, 0, 宽, 高, 配色.背景())
        自身.菜单栏.画(配色)
        自身.工具.画(配色)
        自身.标签条.画(配色)

        令 视图对象: 代码视图 = 自身.视图们[自身.当前]
        视图对象.画(配色)

        如果 (自身.查找条) { 自身.画查找条(配色) }
        如果 (自身.跳转条) { 自身.画跳转条(配色) }

        自身.画状态(配色)
        自身.菜单.画(配色)
    }

    函 画查找条(配色: 主题) {
        变 高 = 查找高
        如果 (自身.替换条) { 高 = 替换高 }
        令 顶 = 自身.窗口高 - 状态高 - 高
        填充矩形(0, 顶, 自身.窗口宽, 高, 配色.面板())
        填充矩形(0, 顶, 自身.窗口宽, 1, 配色.边框())

        左写文字(新建 矩形(8, 顶 + 4, 72, 24), "查找", 0, 配色.次要文字())
        自身.查找框.画(配色)
        自身.按钮上一个.画(配色)
        自身.按钮下一个.画(配色)
        自身.按钮关闭.画(配色)
        自身.按钮区分.画(配色)
        自身.按钮全词.画(配色)
        自身.按钮循环.画(配色)

        如果 (自身.替换条) {
            左写文字(新建 矩形(8, 顶 + 36, 72, 24), "替换", 0, 配色.次要文字())
            自身.替换框.画(配色)
            自身.按钮替换.画(配色)
            自身.按钮全部替换.画(配色)
        }
    }

    函 画跳转条(配色: 主题) {
        令 顶 = 自身.窗口高 - 状态高 - 查找高
        填充矩形(0, 顶, 自身.窗口宽, 查找高, 配色.面板())
        填充矩形(0, 顶, 自身.窗口宽, 1, 配色.边框())
        左写文字(新建 矩形(8, 顶 + 4, 72, 24), "行号", 0, 配色.次要文字())
        自身.跳转框.画(配色)
        自身.按钮跳转.画(配色)
        自身.按钮关闭跳转.画(配色)
    }

    函 画状态(配色: 主题) {
        令 文档对象: 文档 = 自身.文档们[自身.当前]
        变 语言 = "纯文本"
        如果 (文档对象.语言() >= 0 && 文档对象.语言() < 自身.语言数()) {
            语言 = 语言名(文档对象.语言())
        }
        令 左 = ["第 " + 转字符串(文档对象.光标行() + 1) + " 行，第 " + 转字符串(文档对象.光标列() + 1) + " 列",
                "共 " + 转字符串(文档对象.行数()) + " 行",
                "长度 " + 转字符串(文档对象.字数())]
        令 右 = ["UTF-8", 换行名(文档对象.换行方式()), 语言]
        自身.状态.设左侧(左)
        自身.状态.设右侧(右)
        自身.状态.画(配色)
    }
}

// ============================================================
// 启动
// ============================================================
//
// 截图模式：传入非空路径时，第 3 帧画完立刻截图再退出。
// 正常入口与截图入口共享这里，行为没有其他分叉。
函 运行编辑器(截图路径: 字符串, 模式: 整数) -> 整数 {
    令 应用 = 新建 编辑器应用()
    设窗口可缩放(1)
    如果 (!打开窗口("Notepad X", 1120, 720)) { 返回 1 }
    设窗口字体("Consolas", 16, 0)

    // 截图模式给一份全中文示例内容，同时验证中文语法高亮。
    如果 (长度(截图路径) > 0) {
        令 文档对象: 文档 = 应用.文档们[0]
        令 示例行 = [
            "// Notepad X —— X 语言中文模块示例",
            "类 计数器 {",
            "    值: 整数,",
            "",
            "    构造() {",
            "        自身.值 = 0",
            "    }",
            "",
            "    函 加一() {",
            "        自身.值 = 自身.值 + 1",
            "    }",
            "}",
            "",
            "函 主() -> 整数 {",
            "    令 计数 = 新建 计数器()",
            "    变 序号 = 0",
            "    当 (序号 < 10) {",
            "        计数.加一()",
            "        序号 = 序号 + 1",
            "    }",
            "    如果 (计数.值 > 5) {",
            "        打印行(计数.值)",
            "    }",
            "    返回 0",
            "}"
        ]
        文档对象.设文本(拼接(示例行, "\n"))
        文档对象.设名称("示例.xlc")
        文档对象.设语言(语言自研)
        文档对象.设已修改(假)
        令 视图对象: 代码视图 = 应用.视图们[0]
        视图对象.设状态([0])
        视图对象.设滚动(0, 0)
    }

    // 验证模式 1：打开查找/替换面板并填好内容，覆盖面板布局。
    如果 (模式 == 1) {
        应用.打开查找(真)
        应用.查找框.设值("计数")
        应用.替换框.设值("数目")
        应用.区分大小写 = 真
        应用.全词 = 真
        应用.同步开关()
    }

    变 帧 = 0
    当 (!窗口应关闭() && 应用.运行中) {
        令 宽 = 窗口宽度()
        令 高 = 窗口高度()
        应用.布局(宽, 高)

        变 事件 = 取点击事件()
        当 (事件 != 空) {
            令 横 = 转整数(事件[0])
            令 纵 = 转整数(事件[1])
            应用.点(横, 纵)
            事件 = 取点击事件()
        }

        令 滚动 = 取滚轮()
        如果 (滚动 != 0) {
            令 视图对象: 代码视图 = 应用.视图们[应用.当前]
            视图对象.滚轮(滚动)
        }

        变 按键 = 取按键事件()
        当 (按键 != 空) {
            应用.处理按键(按键)
            按键 = 取按键事件()
        }

        应用.处理拖动()

        如果 (应用.菜单号 >= 0) {
            应用.菜单栏.更新悬停(鼠标横(), 鼠标纵())
            如果 (应用.菜单栏.打开序号() != 应用.菜单号) {
                如果 (应用.菜单栏.打开序号() >= 0) {
                    应用.打开菜单(应用.菜单栏.打开序号())
                } 否则 {
                    应用.关闭菜单()
                }
            }
        }

        令 文档对象: 文档 = 应用.文档们[应用.当前]
        变 标题 = 文档对象.标题()
        如果 (文档对象.已修改()) { 标题 = "● " + 标题 }
        设窗口标题(标题 + " - Notepad X")

        开始帧()
        应用.画(宽, 高)
        结束帧()

        帧 = 帧 + 1
        如果 (长度(截图路径) > 0 && 帧 >= 3) {
            令 结果 = 窗口截图(截图路径)
            打印行("截图：" + 转字符串(结果))
            应用.运行中 = 假
        }

        窗口暂停(8)
    }

    关闭窗口()
    返回 0
}
