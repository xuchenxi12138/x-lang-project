// web/container.xle — 依赖容器
//
// ── Spring 的 IoC 容器在本语言里能做到什么程度 ─────────
//
// Spring 容器能做四件事：
//   1. 扫描注解，自动发现 Bean
//   2. 按类型/名字注入构造参数（反射 + 类型匹配）
//   3. 管理单例生命周期（懒加载、作用域）
//   4. 处理循环依赖（三级缓存）
//
// 本语言**没有反射**（P0 没有 getFields/instantiate 之类），所以：
//
//   ✗ 不能扫描注解自动发现 —— 必须显式注册
//   ✗ 不能按类型注入 —— 必须按名字
//   ✗ 不能自动 new —— 必须调用方给构造动作
//
// 能做的只有【3】（生命周期管理）。所以这里的容器是一个
// **「显式注册 + 按名查找 + 单例缓存」**的对象注册表，而不是真正的
// IoC 容器。
//
// ── 为什么要诚实地区分，而不是「尽量像」 ────────────
//
// 因为假的自动注入一定会在某个点崩掉（比如两个 Bean 都符合条件时
// 选了错的那个，而且不报错）。显式注册的容器语法上啰嗦一点，但
// 「谁依赖谁」这件事在代码里是**可读的** —— 这正是真实项目里最
// 需要的东西（三个月后的你自己会感谢这个决定）。

from "../../service/lifecycle.xle" import lcStateName, lcStateInit, lcStateStarting, lcStateRunning, lcStateStopping, lcStateStopped, lcStateFailed, Component, Lifecycle

// 一个已注册的「Bean」。
class Bean {
    // 名字（按名查找的键）。
    name: String

    // 构造动作的名字 —— 由调用方的 dispatch 函数执行真正的 new。
    //
    // ── 为什么存名字而不是存对象 ──────────────────
    //
    // 因为懒加载：注册时不该立刻 new（构造可能要连数据库）。所以
    // 注册只记「怎么造」，第一次 get 时才真正造。
    factoryName: String

    // 已创建的实例（懒加载后填）。
    //
    // ── 为什么用一个平行数组存实例而不是 Any 类型字段 ────
    //
    // 因为语言没有 Any/object 类型。所以实例存在容器的 instances
    // 数组里，Bean 只记录自己的下标。
    instanceIndex: Int

    // 是否已创建。
    created: Bool

    // 作用域：true = 单例，false = 每次 get 都新建。
    singleton: Bool

    constructor(name: String, factoryName: String) {
        self.name          = name
        self.factoryName   = factoryName
        self.instanceIndex = 0 - 1
        self.created       = false
        self.singleton     = true
    }

    fn describe() -> String {
        var s = "lazy"
        if (self.created) { s = "ready" }
        var scope = "singleton"
        if (!self.singleton) { scope = "prototype" }
        return self.name + " [" + scope + "," + s + "] <- " + self.factoryName
    }
}

class Container {
    // 注册的 Bean（按注册顺序 = 通常也是依赖顺序）。
    beans: Array

    // 实例池。Bean.instanceIndex 指向这里。
    instances: Array

    // 注册阶段发现的问题（重名等）。
    errors: Array

    constructor() {
        self.beans     = []
        self.instances = []
        self.errors    = []
    }

    // ── 注册 ──────────────────────────────────────

    // 注册一个单例 Bean。
    fn register(name: String, factoryName: String) -> Bean {
        let b = self.find(name)
        if (len(b.name) > 0) {
            arrPush(self.errors, "Bean `" + name + "` 重复注册（已有的工厂是 `" +
                    b.factoryName + "`，新的被忽略）")
            return b
        }
        let nb = new Bean(name, factoryName)
        arrPush(self.beans, nb)
        return nb
    }

    // 注册一个原型 Bean（每次 get 都新建）。
    //
    // ── 什么时候真的需要原型 ────────────────────
    //
    // 很少。真实场景是「有状态的短生命周期对象」（比如一个请求
    // 级的上下文、一个事务）。但那种东西通常不该由容器管 —— 它
    // 应该由调用方直接 new。
    //
    // 所以这个方法存在，但用它的地方应该先问自己：这东西真的是
    // Bean 吗？还是只是一个普通对象？
    fn registerPrototype(name: String, factoryName: String) -> Bean {
        let b = self.register(name, factoryName)
        b.singleton = false
        return b
    }

    // ── 查找 ──────────────────────────────────────

    fn find(name: String) -> Bean {
        var i = 0
        while i < len(self.beans) {
            let b: Bean = self.beans[i]
            if (b.name == name) { return b }
            i = i + 1
        }
        // 找不到时返回 name 为空的哑对象。调用方用 len(b.name) == 0 判断。
        return new Bean("", "")
    }

    fn has(name: String) -> Bool {
        let b = self.find(name)
        return len(b.name) > 0
    }

    fn count() -> Int {
        return len(self.beans)
    }

    // ── 实例管理 ──────────────────────────────────

    // 把实例存进池，并标记 Bean 已就绪。
    //
    // ── 为什么由调用方传入实例而不是容器自己造 ────────
    //
    // 因为容器不知道该调哪个构造。语言没有反射，除非把「造 bean
    // 的动作」也做成可调用的值（做不到）。
    //
    // 所以模式是：
    //   1. 容器告诉你「db 还没造」（needsCreation）
    //   2. 你在 dispatch 里造好，调 attach 存进来
    fn attach(name: String, instance: Int) -> Array {
        let b = self.find(name)
        if (len(b.name) == 0) {
            return [false, "Bean `" + name + "` 未注册，无法挂载实例"]
        }
        arrPush(self.instances, instance)
        b.instanceIndex = len(self.instances) - 1
        b.created       = true
        return [true, ""]
    }

    // 这个 Bean 是否需要（重新）创建。
    fn needsCreation(name: String) -> Bool {
        let b = self.find(name)
        if (len(b.name) == 0) { return false }
        if (!b.singleton) { return true }        // 原型：永远"需要"
        return !b.created
    }

    // 取实例下标。未创建时返回 -1。
    fn instanceOf(name: String) -> Int {
        let b = self.find(name)
        if (len(b.name) == 0) { return 0 - 1 }
        if (!b.created) { return 0 - 1 }
        return b.instanceIndex
    }

    // ── 按依赖顺序初始化 ────────────────────────────
    //
    // 返回「按注册顺序需要创建的 Bean 名字」。
    //
    // ── 为什么依赖顺序等于注册顺序 ─────────────────
    //
    // 因为注册是显式写的，写的人知道谁依赖谁。要求「被依赖的先注册」
    // 是一个简单、可检查、不会错的约定。
    //
    // Spring 用拓扑排序自动处理顺序，代价是遇到循环依赖时需要三级
    // 缓存这种复杂机制。显式顺序把这个复杂度交给了写代码的人 ——
    // 而那个人本来就知道答案。
    fn creationPlan() -> Array {
        let out = []
        var i = 0
        while i < len(self.beans) {
            let b: Bean = self.beans[i]
            if (self.needsCreation(b.name)) {
                arrPush(out, b.name)
            }
            i = i + 1
        }
        return out
    }

    // 循环依赖检查（注册顺序层面的简单检测）。
    //
    // ── 这个检查能发现什么、不能发现什么 ───────────
    //
    // 能发现：A 的工厂里用了 B，而 B 在 A 之后注册 —— 这会导致 B
    // 还没造好时 A 就来取它，拿到 -1。
    //
    // 不能发现：真正的循环（A 依赖 B，B 依赖 A）。因为「依赖关系」
    // 只存在于工厂函数的代码里，容器看不到。要检测它必须有声明式的
    // 依赖列表 —— 那是另一种复杂度，本实现不引入。
    fn checkOrder(dependencies: Array) -> Array {
        let problems = []
        var i = 0
        while i < len(dependencies) {
            let row: Array = dependencies[i]
            let user: String = row[0]
            let dep: String = row[1]
            let iu = self.indexOfBean(user)
            let id = self.indexOfBean(dep)
            if (iu < 0) {
                arrPush(problems, "`" + user + "` 依赖 `" + dep + "`，但 `" + user + "` 未注册")
            } else if (id < 0) {
                arrPush(problems, "`" + user + "` 依赖 `" + dep + "`，但 `" + dep + "` 未注册")
            } else if (id > iu) {
                arrPush(problems, "`" + user + "` 依赖 `" + dep + "`，" +
                        "但 `" + dep + "` 在之后才注册（应提前）")
            }
            i = i + 1
        }
        return problems
    }

    fn indexOfBean(name: String) -> Int {
        var i = 0
        while i < len(self.beans) {
            let b: Bean = self.beans[i]
            if (b.name == name) { return i }
            i = i + 1
        }
        return 0 - 1
    }

    fn hasErrors() -> Bool {
        return len(self.errors) > 0
    }

    fn errorText() -> String {
        if (len(self.errors) == 0) { return "" }
        var out = "容器有 " + toString(len(self.errors)) + " 个问题："
        var i = 0
        while i < len(self.errors) {
            let e: String = self.errors[i]
            out = out + "\n  - " + e
            i = i + 1
        }
        return out
    }

    fn dump() -> String {
        var out = "Container(" + toString(len(self.beans)) + " Bean, " +
                  toString(len(self.instances)) + " 实例)"
        var i = 0
        while i < len(self.beans) {
            let b: Bean = self.beans[i]
            out = out + "\n  " + padZero(i + 1, 2) + ". " + b.describe()
            i = i + 1
        }
        return out
    }
}