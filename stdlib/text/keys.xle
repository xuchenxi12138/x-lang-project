// ============================================================
// std.text.keys —— 键盘事件、虚拟键码与修饰位
// ============================================================
//
// ── 为什么需要这一层 ────────────────────────────────────────
//
// winPollKey() 返回的是裸数据 [key, ch, mods]：key 是 Win32 虚拟
// 键码（37=左方向键），mods 是位掩码（2=Ctrl）。应用里直接写
// `if (key == 37)` 或 `if (mods / 2 % 2 == 1)` 到处都是「魔数 +
// 位运算」，改一个快捷键要在十几个文件里找。
//
// 这里把三件事收拢：
//   1. 虚拟键码有名字（VK_LEFT、VK_DELETE……）
//   2. 修饰位有名字与查询函数（modCtrl(mods)，避免位运算符）
//   3. 键名与快捷键文本（状态栏、菜单、帮助里显示 "Ctrl+S"）
//
// ── 不用位运算符 ─────────────────────────────────────────
//
// 语言目前没有稳定的位运算保证，mods 的取值又只有 0..7，所以用
// `(mods / bit) % 2 == 1` 判断。`modCtrl(6)` → 6/2%2=1 → 真；
// `modCtrl(4)` → 4/2%2=0 → 假。与位测试完全等价。

// 修饰位（与 gui_win32.c 的 current_mods 一致）
const MOD_SHIFT = 1
const MOD_CTRL  = 2
const MOD_ALT   = 4

// ── 虚拟键码 ────────────────────────────────────────────
//
// 只列编辑器用得到的：功能键、编辑键、字母、数字、几个 OEM 符号。
// 值就是 Win32 VK_*，与 keys.xle 无关联的代码可以按数字理解。

const VK_BACK    = 8
const VK_TAB     = 9
const VK_RETURN  = 13
const VK_SHIFT   = 16
const VK_CONTROL = 17
const VK_MENU    = 18
const VK_ESCAPE  = 27
const VK_SPACE   = 32
const VK_PRIOR   = 33     // PageUp
const VK_NEXT    = 34     // PageDown
const VK_END     = 35
const VK_HOME    = 36
const VK_LEFT    = 37
const VK_UP      = 38
const VK_RIGHT   = 39
const VK_DOWN    = 40
const VK_INSERT  = 45
const VK_DELETE  = 46

const VK_0 = 48
const VK_1 = 49
const VK_2 = 50
const VK_3 = 51
const VK_4 = 52
const VK_5 = 53
const VK_6 = 54
const VK_7 = 55
const VK_8 = 56
const VK_9 = 57

const VK_A = 65
const VK_B = 66
const VK_C = 67
const VK_D = 68
const VK_E = 69
const VK_F = 70
const VK_G = 71
const VK_H = 72
const VK_I = 73
const VK_J = 74
const VK_K = 75
const VK_L = 76
const VK_M = 77
const VK_N = 78
const VK_O = 79
const VK_P = 80
const VK_Q = 81
const VK_R = 82
const VK_S = 83
const VK_T = 84
const VK_U = 85
const VK_V = 86
const VK_W = 87
const VK_X = 88
const VK_Y = 89
const VK_Z = 90

const VK_F1  = 112
const VK_F2  = 113
const VK_F3  = 114
const VK_F4  = 115
const VK_F5  = 116
const VK_F6  = 117
const VK_F7  = 118
const VK_F8  = 119
const VK_F9  = 120
const VK_F10 = 121
const VK_F11 = 122
const VK_F12 = 123

// OEM 符号（美式键盘布局）。Ctrl+= 在中文输入法下常被吞掉，
// 但 WM_KEYDOWN 仍然送 VK_OEM_PLUS，所以缩放快捷键能工作。
const VK_OEM_SEMI   = 186   // ;:
const VK_OEM_PLUS   = 187   // =+
const VK_OEM_COMMA  = 188   // ,<
const VK_OEM_MINUS  = 189   // -_
const VK_OEM_PERIOD = 190   // .>
const VK_OEM_1      = 191   // /?
const VK_OEM_TILDE  = 192   // `~
const VK_OEM_LBRACK = 219   // [{
const VK_OEM_BACKSL = 220   // \|
const VK_OEM_RBRACK = 221   // ]}
const VK_OEM_QUOTE  = 222   // '"
const VK_NUMPAD_PLUS  = 107
const VK_NUMPAD_MINUS = 109
const VK_NUMPAD_0     = 96

// ── 事件访问 ────────────────────────────────────────────
//
// ev 一定是 winPollKey() 返回的非 null 数组，长度 3。
// 调用方先判 null 再调用这里 —— 参数类型是 Array，不接收 null。

fn keyCode(ev: Array) -> Int {
    return toInt(ev[0])
}

fn keyChar(ev: Array) -> String {
    return toString(ev[1])
}

fn keyMods(ev: Array) -> Int {
    return toInt(ev[2])
}

// 这一条事件带可打印字符吗？带字符的 key 恒为 0。
fn keyHasChar(ev: Array) -> Bool {
    return len(keyChar(ev)) > 0
}

// ── 修饰位查询 ──────────────────────────────────────────

fn modBit(mods: Int, bit: Int) -> Bool {
    if (bit <= 0) { return false }
    return (mods / bit) % 2 == 1
}

fn modShift(mods: Int) -> Bool { return modBit(mods, MOD_SHIFT) }
fn modCtrl(mods: Int)  -> Bool { return modBit(mods, MOD_CTRL) }
fn modAlt(mods: Int)   -> Bool { return modBit(mods, MOD_ALT) }

// ── 键名与快捷键文本 ────────────────────────────────────

// 键的可读名。字母/数字返回字符本身；其余返回 VK 名。
// 返回 "" 表示这是一个「没有名字」的键（调用方可以忽略）。
fn keyName(key: Int) -> String {
    if (key >= 65 && key <= 90) { return strFromCode(key) }
    if (key >= 48 && key <= 57) { return strFromCode(key) }
    if (key >= 112 && key <= 123) { return "F" + toString(key - 111) }
    if (key == VK_LEFT)   { return "Left" }
    if (key == VK_RIGHT)  { return "Right" }
    if (key == VK_UP)     { return "Up" }
    if (key == VK_DOWN)   { return "Down" }
    if (key == VK_HOME)   { return "Home" }
    if (key == VK_END)    { return "End" }
    if (key == VK_PRIOR)  { return "PageUp" }
    if (key == VK_NEXT)   { return "PageDown" }
    if (key == VK_DELETE) { return "Delete" }
    if (key == VK_BACK)   { return "Backspace" }
    if (key == VK_RETURN) { return "Enter" }
    if (key == VK_TAB)    { return "Tab" }
    if (key == VK_ESCAPE) { return "Esc" }
    if (key == VK_INSERT) { return "Insert" }
    if (key == VK_SPACE)  { return "Space" }
    if (key == VK_OEM_PLUS)  { return "+" }
    if (key == VK_OEM_MINUS) { return "-" }
    if (key == VK_OEM_SEMI)  { return ";" }
    if (key == VK_OEM_COMMA) { return "," }
    if (key == VK_OEM_PERIOD) { return "." }
    if (key == VK_OEM_1)     { return "/" }
    if (key == VK_OEM_TILDE) { return "`" }
    return ""
}

// 快捷键文本：按 Ctrl+Alt+Shift 的顺序拼。菜单右栏直接显示它。
fn shortcutText(key: Int, mods: Int) -> String {
    var s = ""
    if (modCtrl(mods))  { s = s + "Ctrl+" }
    if (modAlt(mods))   { s = s + "Alt+" }
    if (modShift(mods)) { s = s + "Shift+" }
    return s + keyName(key)
}
