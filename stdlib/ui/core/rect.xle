// ui/core/rect.xle — 矩形（几何基础类型）
//
// ── 为什么第一个拆出来的是它 ──────────────────────────
//
// 布局、命中判定、裁剪、绘制，四件事都在说「一块矩形」。它是组件库
// 里唯一一个**被所有人依赖、自己不依赖任何人**的类型。先定死它，
// 上层 20 多个组件的签名才有共同语言。
//
// ── 为什么是 struct 而不是 class ─────────────────────
//
// 矩形是**值**：传参、返回、存字段，语义上都是复制。用 class 会
// 引入引用语义，导致 `let a = b` 之后改 a 影响 b —— 而布局计算里
// 「拿一个矩形算完之后挪一下」是最高频的操作，引用语义会让它变成
// bug 温床。
//
// struct 的代价是不能有默认值得靠字面量构造，而字面量恰好最清楚：
// `Rect { x: 0, y: 0, w: 100, h: 30 }` 一眼看出四个数在说什么。

struct Rect {
    x: Int,
    y: Int,
    w: Int,
    h: Int,
}

// ── 构造：从「左上右下」造 ───────────────────────────

fn rectOf(x: Int, y: Int, w: Int, h: Int) -> Rect {
    return Rect { x: x, y: y, w: w, h: h }
}

fn rectFromLTRB(l: Int, t: Int, r: Int, b: Int) -> Rect {
    return Rect { x: l, y: t, w: r - l, h: b - t }
}

// 零点矩形。用函数而不是常量，因为 struct 值不能做顶层 const
// （const 只接受字面量）。
fn rectZero() -> Rect {
    return Rect { x: 0, y: 0, w: 0, h: 0 }
}

// ── 派生量 ─────────────────────────────────────────
//
// 这些写成 `Rect.right(r)` 形式而不是 `r.right()`，理由见文件末尾
// 关于链式调用的说明。

fn Rect.right(self: Rect) -> Int { return self.x + self.w }
fn Rect.bottom(self: Rect) -> Int { return self.y + self.h }
fn Rect.area(self: Rect) -> Int { return self.w * self.h }
fn Rect.cx(self: Rect) -> Int { return self.x + self.w / 2 }
fn Rect.cy(self: Rect) -> Int { return self.y + self.h / 2 }

fn Rect.isEmpty(self: Rect) -> Bool {
    return self.w <= 0 || self.h <= 0
}

// ── 关系判定 ──────────────────────────────────────

fn Rect.contains(self: Rect, px: Int, py: Int) -> Bool {
    return px >= self.x && px < self.x + self.w &&
           py >= self.y && py < self.y + self.h
}

// 包含关系用「完全在内」而不是「有交集」：布局里问「这个子控件
// 是否溢出父容器」时，需要的是前者。
fn Rect.containsRect(self: Rect, o: Rect) -> Bool {
    return o.x >= self.x && o.y >= self.y &&
           o.x + o.w <= self.x + self.w &&
           o.y + o.h <= self.y + self.h
}

fn Rect.overlaps(self: Rect, o: Rect) -> Bool {
    return self.x < o.x + o.w && o.x < self.x + self.w &&
           self.y < o.y + o.h && o.y < self.y + self.h
}

// 交集。无交集时返回零点矩形而不是 null —— 布局代码里下一步
// 通常是「画交集」，null 会让每个调用点都要判空。
fn Rect.intersect(self: Rect, o: Rect) -> Rect {
    let l = self.x
    if (o.x > l) { l = o.x }
    let t = self.y
    if (o.y > t) { t = o.y }
    let r = Rect.right(self)
    if (Rect.right(o) < r) { r = Rect.right(o) }
    let b = Rect.bottom(self)
    if (Rect.bottom(o) < b) { b = Rect.bottom(o) }
    if (r <= l || b <= t) { return rectZero() }
    return rectFromLTRB(l, t, r, b)
}

// 并集（外接矩形）。
fn Rect.union(self: Rect, o: Rect) -> Rect {
    if (Rect.isEmpty(self)) { return o }
    if (Rect.isEmpty(o)) { return self }
    let l = self.x
    if (o.x < l) { l = o.x }
    let t = self.y
    if (o.y < t) { t = o.y }
    let r = Rect.right(self)
    if (Rect.right(o) > r) { r = Rect.right(o) }
    let b = Rect.bottom(self)
    if (Rect.bottom(o) > b) { b = Rect.bottom(o) }
    return rectFromLTRB(l, t, r, b)
}

// ── 变换（全部返回值语义的新矩形）─────────────────────

fn Rect.inset(self: Rect, d: Int) -> Rect {
    return rectOf(self.x + d, self.y + d, self.w - 2 * d, self.h - 2 * d)
}

// 四边独立内缩。卡片内边距常需要「上下 8、左右 16」。
fn Rect.insetBy(self: Rect, dx: Int, dy: Int) -> Rect {
    return rectOf(self.x + dx, self.y + dy, self.w - 2 * dx, self.h - 2 * dy)
}

fn Rect.offset(self: Rect, dx: Int, dy: Int) -> Rect {
    return rectOf(self.x + dx, self.y + dy, self.w, self.h)
}

// 按父容器的内边距收缩。名字带 InOf 是为了和 inset 区分：
// inset 收自己，inOf 是「父容器留出 padding 后剩下的可用区」。
fn Rect.inOf(self: Rect, pad: Int) -> Rect {
    return Rect.inset(self, pad)
}

// 只留左半边 / 右半边。分栏布局的最小积木。
fn Rect.leftHalf(self: Rect, gap: Int) -> Rect {
    return rectOf(self.x, self.y, self.w / 2 - gap / 2, self.h)
}

fn Rect.rightHalf(self: Rect, gap: Int) -> Rect {
    let hw = self.w / 2 - gap / 2
    return rectOf(self.x + self.w - hw, self.y, hw, self.h)
}

// 按百分比切。0..100。
fn Rect.leftPct(self: Rect, pct: Int) -> Rect {
    let w = self.w * pct / 100
    return rectOf(self.x, self.y, w, self.h)
}

fn Rect.rightOf(self: Rect, pct: Int) -> Rect {
    let x = self.x + self.w * pct / 100
    return rectOf(x, self.y, self.x + self.w - x, self.h)
}

// 从顶部/底部切一条固定高度。
fn Rect.stripTop(self: Rect, h: Int) -> Rect {
    return rectOf(self.x, self.y, self.w, h)
}

fn Rect.stripBottom(self: Rect, h: Int) -> Rect {
    return rectOf(self.x, self.y + self.h - h, self.w, h)
}

// 「下面接一块」。返回的是**新块**，不是剩余空间 —— 剩余空间用
// dropTop 拿。分开是因为两者都常用，合成一个函数就得返回 Array
// 再拆，可读性反而差。
fn Rect.below(self: Rect, h: Int, gap: Int) -> Rect {
    return rectOf(self.x, self.y + self.h + gap, self.w, h)
}

// 去掉顶部一条后剩余的部分。
fn Rect.dropTop(self: Rect, h: Int) -> Rect {
    return rectOf(self.x, self.y + h, self.w, self.h - h)
}

fn Rect.dropBottom(self: Rect, h: Int) -> Rect {
    return rectOf(self.x, self.y, self.w, self.h - h)
}

// ── 对齐 ─────────────────────────────────────────
//
// 把一块指定尺寸的盒子放进容器里，按九宫格对齐。按钮居中、
// 图标靠右这类需求都走它，避免到处手算。
//
//   ax: 0=左 1=中 2=右      ay: 0=上 1=中 2=下

fn Rect.align(self: Rect, w: Int, h: Int, ax: Int, ay: Int) -> Rect {
    var x = self.x
    if (ax == 1) { x = self.x + (self.w - w) / 2 }
    if (ax == 2) { x = self.x + self.w - w }
    var y = self.y
    if (ay == 1) { y = self.y + (self.h - h) / 2 }
    if (ay == 2) { y = self.y + self.h - h }
    return rectOf(x, y, w, h)
}

// 居中的简写。用得最多所以单列一条。
fn Rect.center(self: Rect, w: Int, h: Int) -> Rect {
    return Rect.align(self, w, h, 1, 1)
}

// 居中到一个窗口坐标（对话框、模态框用）。
fn rectCentered(winW: Int, winH: Int, w: Int, h: Int) -> Rect {
    return rectOf((winW - w) / 2, (winH - h) / 2, w, h)
}

// ── 为什么不用链式调用 ───────────────────────────────
//
// `r.inset(8).offset(2, 0)` 这种写法看着更顺，但本语言的编译器
// **不做返回值的结构化推断**：`inset` 返回 Rect，而 `Rect.right(r)`
// 这种点号调用需要「宿主是哪个 struct」在编译期确定，链式第二段
// 就拿不到宿主类型了（实测报「无法确定 .offset 的宿主类型」）。
//
// 所以全部写成 `Rect.xxx(r, ...)` 的形式：类型显式写在前面，
// 每一步都是「拿一个 Rect 算一个新 Rect」，中间变量可读性也不差：
//
//     let pad = Rect.inset(r, 8)
//     let box = Rect.offset(pad, 2, 0)
//
// 这不是风格偏好，是当前编译器能力的边界。等 P1 做了返回类型
// 推断，可以再加一层链式包装，函数体不用改。