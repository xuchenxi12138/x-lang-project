// tests/pkg/zh-app/src/main.xlc — L2 中文别名包的端到端验证（中文版）
//
// 与 main.xle（英文关键字孪生版）逐行对应：标识符完全相同，
// 只有关键字一个是中文一个是英文。验收两条：
//
//   1. 输出与 main.expect 逐字节一致（别名真的能用）
//   2. 两份文件编出的指令序列一致（zh 包 + 词法归一化都没有
//      把语义带偏 —— 04 §7 的「中英产物逐字节一致」在 L2 层的延续）
//
// 这个程序刻意覆盖 zh 包的每个分组（核心/数学/统计/字符串/
// 数组/文件/随机/转换），且全部输出可手算验证、与时间无关
// （随机用固定种子，时间类内建不进断言）。

引入 @zh

函 主() -> 整数 {
    // 核心：多态包装
    打印行(转字符串(6) + " * 7 = " + 转字符串(42))
    打印行(长度("中文"))

    // 数学与数论
    打印行(开方(144.0))
    打印行(幂(2.0, 8.0))
    打印行(阶乘(6))
    打印行(是质数(89))
    打印行(最大公约数(12, 18))

    // 统计
    令 xs = 建数组(4, 0.0)
    xs[0] = 1.0
    xs[1] = 2.0
    xs[2] = 3.0
    xs[3] = 4.0
    打印行(求和(xs))
    打印行(平均值(xs))

    // 字符串
    令 s = "中文编程"
    打印行(取子串(s, 0, 2))
    打印行(查找(s, "程"))
    打印行(拼接(切分("x,y,z", ","), "+"))
    打印行(替换("甲乙丙", "乙", "二"))

    // 数组
    令 ys = 建数组(2, 0)
    追加(ys, 9)
    追加(ys, 7)
    打印行(长度(ys))
    打印行(查找(ys, 7))
    打印行(包含(ys, 9))
    打印行(长度(去重(取段(ys, 0, 2))))
    令 排好的 = 已排序(ys)
    打印行(排好的[0])

    // 类型保持（Any 透传返回）与数组重载
    打印行(绝对值(-12))
    打印行(绝对值(-3.5))
    打印行(弹出(ys))

    // 文件
    令 p = "zh_app_test.txt"
    写文件(p, "甲\n乙\n")
    打印行(长度(按行读(p)))
    打印行(读文件或(p, "无") == "甲\n乙\n")
    打印行(删除文件(p))
    打印行(存在吗(p))

    // 随机（固定种子，两次应相同）
    设随机种子(7)
    令 r1 = 随机数()
    设随机种子(7)
    打印行(r1 == 随机数())

    // 转换
    打印行(转整数或("x", 5))
    打印行(保留小数(1.0 / 3.0, 4))
    打印行(补零(42, 5))
    打印行(中文别名版本)

    返回 0
}
