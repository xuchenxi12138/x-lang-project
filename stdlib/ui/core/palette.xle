// ui/core/palette.xle — 默认色板
//
// ── 为什么色板要和 Theme 分开 ──────────────────────────
//
// 因为它们的生命周期不同。色板是「出厂设定的那 13 个数」，基本
// 不动；Theme 是「运行时选中的一套配色」，会被替换、派生、按窗口
// 传递。混在一个文件里，读代码的人会以为改 Theme 就是改色板。
//
// 而且拆分后有个实际好处：想加一套新主题（比如「高对比度」），
// 只需要在 theme.xle 里加一个 `Theme.highContrast()`，色板文件
// 一行都不用碰。
//
// ── 为什么是 const 而不是 struct ────────────────────────
//
// 这些是「编译期字面量」，const 能保证零运行时开销。而 Theme 是
// struct 值，可以被传递和派生。两者处在不同层次：色板喂给 Theme，
// 而不是替代它。
//
// 注意：P0 的顶层 const 只接受字面量，不能写 `const A = B + 1`。
// 所以这 13 个数只能各写一遍，没有派生余地。这也是为什么 Theme
// 要提供 `withAccent` 这类派生方法 —— 派生逻辑放在函数里。

// ── 深色（默认）────────────────────────────────────

const UI_BG        = 0x1E1E24   // 窗口底色
const UI_SURFACE   = 0x2A2A33   // 面板 / 控件底
const UI_SURFACE_H = 0x34343F   // 悬停
const UI_SURFACE_A = 0x3E3E4C   // 按下
const UI_BORDER    = 0x3F3F4D
const UI_TEXT      = 0xE8E8F0
const UI_TEXT_DIM  = 0x9A9AA8
const UI_ACCENT    = 0x3B82F6   // 主色（蓝）
const UI_ACCENT_D  = 0x2563EB   // 主色按下
const UI_OK        = 0x22C55E
const UI_WARN      = 0xF59E0B
const UI_ERR       = 0xEF4444
const UI_TRACK     = 0x22222A   // 滑条轨/进度槽

// ── 语义色补充 ──────────────────────────────────────
//
// 上面那批只管「控件底色」，而实际组件还需要几类语义色：
// 遮罩、阴影、焦点环、禁用文字。它们原先散在各组件的绘制代码里
// 硬编码，收在这里之后换主题才能一致。

// 模态遮罩。半透明黑在 0xRRGGBB 里表达不了，窗口层用
// winAlpha 控制整体透明度，所以这里是「遮罩用的纯黑」。
const UI_SCRIM    = 0x000000

// 阴影色。同样靠 winAlpha 压透明度。
const UI_SHADOW   = 0x101014

// 焦点环。键盘导航时高亮当前控件，是 accessiblity 的最低要求。
const UI_FOCUS    = 0x60A5FA

// 禁用态。比 textDim 更弱，用于「不可点但可见」的控件。
const UI_DISABLED = 0x6B6B7B

// ── 通用哨兵 ────────────────────────────────────────
//
// 「没有指定颜色」的统一表示。用 -1 而不是 0，因为 0 是合法的
// 纯黑 —— 用 0 当哨兵会让「故意要黑」变成「没设颜色」。
const UI_NONE = -1