// tests/pkg/zh-app/src/main.xle — main.xlc 的英文关键字孪生版
//
// 标识符与中文版完全相同（zh 包的函数名本来就是中文的，两个文件
// 都用它们），只有关键字一套是英文。两条验收见 main.xlc 顶部注释。

from @zh import 打印行, 打印, 转字符串, 转整数, 转浮点, 长度, 建数组, 开方, 幂, 立方根, 向下取整, 向上取整, 四舍五入, 截断小数, 正弦, 余弦, 正切, 反正弦, 反余弦, 反正切, 自然对数, 二进对数, 常用对数, 指数, 斜边长, 浮点求余, 绝对值, 最小值, 最大值, 符号, 阶乘, 组合数, 最大公约数, 最小公倍数, 是质数, 近似相等, 线性插值, 归一化, 求和, 平均值, 方差, 总体方差, 标准差, 总体标准差, 中位数, 数值最大值, 数值最小值, 数值乘积, 零矩阵, 全一矩阵, 单位矩阵, 矩阵加, 矩阵减, 对位乘, 矩阵缩放, 矩阵乘, 转置, 取元素, 设元素, 取字符, 取子串, 查找, 查找自, 切分, 拼接, 转大写, 转小写, 去首尾空白, 替换, 开头是, 结尾是, 重复, 字符码, 码转字符, 解析整数, 解析浮点, 是空串, 是空白串, 左补齐, 右补齐, 居中补齐, 显示宽度, 出现次数, 反转, 行数, 追加, 插入, 取段, 合并, 倒转, 排序, 复制, 包含, 填充, 所有下标, 是空数组, 取前n个, 去前n个, 去重, 展平, 已排序, 降序排序, 洗牌, 抽取, 并集, 交集, 差集, 分块, 取行, 取列, 每项乘, 每项加, 每项取绝对值, 每项转整数, 每项转浮点, 每项转字符串, 筛选等于, 筛选不等于, 筛选大于, 筛选小于, 读文件, 读文件或, 写文件, 追加写, 存在吗, 是目录吗, 删除文件, 文件大小, 列目录, 建目录, 确保目录, 深度写, 按行读, 按行写, 追加一行, 拼路径, 取文件名, 取目录名, 取扩展名, 随机数, 设随机种子, 当前毫秒, 当前秒, 单调毫秒, 睡眠, 弹出, 转整数或, 转浮点或, 转布尔, 转布尔或, 转十六进制, 转二进制, 转八进制, 从十六进制, 从二进制, 补零, 保留小数, 千分位, 百分比, 布尔转字符串, 是整数样, 是浮点样, 中文别名版本

fn main() -> Int {
    // 核心：多态包装
    打印行(转字符串(6) + " * 7 = " + 转字符串(42))
    打印行(长度("中文"))

    // 数学与数论
    打印行(开方(144.0))
    打印行(幂(2.0, 8.0))
    打印行(阶乘(6))
    打印行(是质数(89))
    打印行(最大公约数(12, 18))

    // 统计
    let xs = 建数组(4, 0.0)
    xs[0] = 1.0
    xs[1] = 2.0
    xs[2] = 3.0
    xs[3] = 4.0
    打印行(求和(xs))
    打印行(平均值(xs))

    // 字符串
    let s = "中文编程"
    打印行(取子串(s, 0, 2))
    打印行(查找(s, "程"))
    打印行(拼接(切分("x,y,z", ","), "+"))
    打印行(替换("甲乙丙", "乙", "二"))

    // 数组
    let ys = 建数组(2, 0)
    追加(ys, 9)
    追加(ys, 7)
    打印行(长度(ys))
    打印行(查找(ys, 7))
    打印行(包含(ys, 9))
    打印行(长度(去重(取段(ys, 0, 2))))
    let 排好的 = 已排序(ys)
    打印行(排好的[0])

    // 类型保持（Any 透传返回）与数组重载
    打印行(绝对值(-12))
    打印行(绝对值(-3.5))
    打印行(弹出(ys))

    // 文件
    let p = "zh_app_test.txt"
    写文件(p, "甲\n乙\n")
    打印行(长度(按行读(p)))
    打印行(读文件或(p, "无") == "甲\n乙\n")
    打印行(删除文件(p))
    打印行(存在吗(p))

    // 随机（固定种子，两次应相同）
    设随机种子(7)
    let r1 = 随机数()
    设随机种子(7)
    打印行(r1 == 随机数())

    // 转换
    打印行(转整数或("x", 5))
    打印行(保留小数(1.0 / 3.0, 4))
    打印行(补零(42, 5))
    打印行(中文别名版本)

    return 0
}
