// 08-zh.x — 中文关键字模式（04 文档层 1：纯词法别名）
//
// 用 `--zh` 编译本文件。
//
// 分层说明（04 §1/§3，这里必须写清，否则容易误以为「中文支持不完整」）：
//
//   L1 词法层（本文件验证的）：
//     关键字    令 / 变 / 函 / 如果 / 否则 / 当 / 返回 / 真 / 假 / 空 ...
//     内建类型  整数 / 浮点 / 布尔 / 字符串 ...
//     这些是编译器内置、零成本、可关闭的。
//
//   L2 别名包（本文件不验证，见 tests/pkg/zh-app）：
//     println → 打印行, sqrt → 开方, len → 长度 ...
//     这些是普通库符号，由 `引入 @zh` 提供（x-lang/pkg/zh），
//     编译器不为它们做任何特殊处理 —— 包管理于 v0.12 落地后，
//     L2 的端到端验证在 zh-app：输出正确性 + 中英字节码一致。
//
// 本文件与 08-zh-en.x 结构逐行对应。用 --zh 编译本文件与直接编译英文版，
// 生成的字节码除字符串常量外应完全一致 —— 这就是「中文零成本」的证据。

令 name_ = "X"
令 version = 0.7

函 square(n: 浮点) -> 浮点 {
    返回 n * n
}

函 factorial(n: 整数) -> 整数 {
    如果 n <= 1 {
        返回 1
    }
    返回 n * factorial(n - 1)
}

println("语言: " + name_)
println("版本: " + version)
println("平方: " + square(1.5))
println("阶乘: " + factorial(6))

变 sum_ = 0
变 i: 整数 = 1
当 i <= 10 {
    sum_ += i
    i += 1
}
println("1..10 之和: " + sum_)

如果 sum_ > 50 {
    println("和大于 50")
} 否则 {
    println("和不超过 50")
}

// 真值与空值的中文写法
令 flag: 布尔 = 真
令 nothing = 空
如果 flag {
    println("标志为真")
}
如果 nothing {
    println("不该打印")
} 否则 {
    println("空值按假处理")
}