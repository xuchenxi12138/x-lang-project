// net/index.xle — 网络层统一入口
//
// ── 这一层提供什么 ────────────────────────────────
//
//   core/tcp_listener   TCP 监听器（端口监听）
//   core/tcp_stream     TCP 连接（收发字节与文本）
//   http/uri            URL 解析与百分号编码
//   http/header         HTTP 头（大小写无关、重复头、折行）
//   http/cookie         Cookie 解析与生成
//   http/status         状态码与使用建议
//   http/request        请求报文解析（含走私检测）
//   http/response       响应序列化（含 HEAD/204 处理）
//   http/reader         从流里读报文（Content-Length / chunked）
//   http/router         路径路由（参数、通配、405）
//   http/server         HTTP 服务端（单线程事件循环模型）
//   http/client         HTTP 客户端（单次请求，无连接池）
//
// ── 为什么要有这个文件 ─────────────────────────
//
// 因为调用方通常会说「我需要 HTTP」，而不是「我需要 header.xle」。
// 有入口文件之后，一行 import 就能拿到整层能力，且不用记住文件布局。
//
// 这与「一个文件一个类」不冲突：那些文件仍然是独立、可单独 import
// 的（比如只做 URL 解析的程序不该被拖进 HTTP 服务端的依赖）。

from "core/tcp_listener.xle" import TcpListener, TL_POLL_MS, TL_DEFAULT_WAIT_MS
from "core/tcp_stream.xle" import TcpStream, TS_POLL_MS, TS_DEFAULT_WAIT_MS
