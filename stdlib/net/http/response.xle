from "../../str.xle" import strIsEmpty, strIsBlank, strTrimStart, strTrimEnd, strPadLeft, strPadRight, strPadCenter, strDisplayWidth, strPadDisplayRight, strSplitN, strLines, strLineCount, strReplaceN, strFindNth, strCount, strReverse, strFirstLine, strEllipsis, strIsInt, strIsFloat, strChar, strRule, strBasename, strDirname, strExtname, strJoinPath, strTemplate
from "../../conv.xle" import toIntOr, toFloatOr, convIsIntLike, convIsFloatLike, toBool, toBoolOr, boolToString, toBase, toHex, toBin, toOct, fromHex, fromBin, padZero, fixed, thousands, percent, bytes, numbersToString, stringToNumbers, stringToInts, isSpace, isPrintableAscii, escapeChar
from "../../db/codec/bytes.xle" import bbNew, bbFromUtf8, bbFromRaw, bbPut, bbPutBytes, bbPutUtf8, bbPutRaw, bbPutU8, bbPutU16BE, bbPutU16LE, bbPutU24BE, bbPutU24LE, bbPutU32BE, bbPutU32LE, bbPutU64BE, bbPutU64LE, bbAt, bbU8, bbU16BE, bbU16LE, bbU24BE, bbU24LE, bbU32BE, bbU32LE, bbU64BE, bbU64LE, bbToText, bbToWire, bbSlice, bbHex, bbEq, bbIndexOf, bbConcat, bbClone, bbConcat3, bbFindSeq, bbSplitSeq

// net/http/response.xle — 一个 HTTP 响应
//
// ── 响应最容易错的四件事 ──────────────────────────
//
// 【1】Content-Length 与 Transfer-Encoding 二选一
//
//   有 body 却没告诉客户端有多长，客户端只能等连接关闭才知道结束
//   （HTTP/1.0 风格）。在 keep-alive 连接上这会直接挂死 —— 因为
//   连接不会关。所以本实现的 serialize 会**自动**补 Content-Length。
//
// 【2】204 / 304 不能有 body
//
//   见 status.xle 的 hsHasNoBody。带了 body 会让 keep-alive 复用
//   时后续响应全部错位。
//
// 【3】HEAD 请求的响应不能有 body，但 Content-Length 要保留
//
//   HEAD 的语义是「只给头，不给内容」，而头里的 Content-Length 必须
//   与对应的 GET 一致 —— 客户端靠它判断资源大小、决定要不要下载。
//   如果连 Content-Length 也去掉，HEAD 就失去意义了。
//
// 【4】Date 头缺失是协议违规
//
//   RFC 7231 §7.1.1.2：源服务器**必须**在能获取时钟时发 Date。
//   缺了不是致命的，但会导致缓存计算 age 出错、日志排序困难。

from "header.xle" import arrRemoveAt, Headers, HD_COLON, HD_MAX_LINE
from "status.xle" import hsCommonCodes, hsReason, hsClass, hsHasNoBody, hsAdvice
from "cookie.xle" import ckParseRequestHeader, ckGet, ckDelete, SetCookie

class Response {
    // 状态码。
    status: Int

    // 原因短语。空串表示「用 hsReason(status) 的标准短语」。
    //
    // ── 为什么允许自定义 ────────────────────────
    //
    // 因为少数场景需要非标准短语（老系统可能按短语字符串判断，
    // 虽然那是错的）。留一个口子比让人去改源码好。
    reason: String

    // 协议版本。默认与请求一致，通常不用改。
    version: String

    // 头。
    headers: Headers

    // body 字节。
    body: Array

    // 待下发的 Set-Cookie 列表。
    //
    // ── 为什么不直接塞进 headers ─────────────────────
    //
    // 因为塞进去就失去了「结构化」的好处：想改某个 cookie 的 Path
    // 得回去解析字符串。而且 Set-Cookie 是唯一「必须重复」的头，
    // 单独放在一个数组里能保证序列化时绝不合并。
    cookies: Array

    constructor(status: Int) {
        self.status  = status
        self.reason  = ""
        self.version = "HTTP/1.1"
        self.headers = new Headers()
        self.body    = []
        self.cookies = []
    }

    // ── 构造糖 ────────────────────────────────────

    static fn ok() -> Response {
        return new Response(200)
    }

    static fn withStatus(code: Int) -> Response {
        return new Response(code)
    }

    // 文本响应。自动设置 Content-Type。
    //
    // ── 为什么默认带 charset=utf-8 ────────────────
    //
    // 因为不带 charset 时，浏览器按**页面语言猜测**编码（HTML5 的
    // 嗅探算法），中文场景下经常猜成 GBK，表现为「全是乱码」。
    // 显式声明是唯一可靠的解法。
    static fn text(code: Int, body: String) -> Response {
        let r = new Response(code)
        r.headers.set("Content-Type", "text/plain; charset=utf-8")
        r.body = bbFromUtf8(body)
        return r
    }

    static fn html(code: Int, body: String) -> Response {
        let r = new Response(code)
        r.headers.set("Content-Type", "text/html; charset=utf-8")
        r.body = bbFromUtf8(body)
        return r
    }

    static fn json(code: Int, body: String) -> Response {
        let r = new Response(code)
        r.headers.set("Content-Type", "application/json; charset=utf-8")
        r.body = bbFromUtf8(body)
        return r
    }

    // 字节响应（图片、文件、压缩包）。
    //
    // contentType 必须显式给 —— 因为没有可靠的方式从字节猜类型
    // （文件头魔数只覆盖少数格式，且猜错时浏览器行为是「下载」
    // 而不是「显示」，看起来像 404 之后的第二个 bug）。
    static fn bytes(code: Int, data: Array, contentType: String) -> Response {
        let r = new Response(code)
        r.headers.set("Content-Type", contentType)
        r.body = data
        return r
    }

    // 空响应（204 / 304 专用）。
    static fn empty(code: Int) -> Response {
        let r = new Response(code)
        r.body = []
        return r
    }

    // 重定向。
    //
    // ── 为什么 code 必须是 3xx ─────────────────────
    //
    // 因为 Location 头在非 3xx 响应里**被忽略**。发一个 200 带
    // Location 不会跳转，客户端只是收到一个普通响应 —— 而写代码
    // 的人会以为跳转生效了，然后困惑「为什么没跳」。
    static fn redirect(code: Int, location: String) -> Response {
        let r = new Response(code)
        r.headers.set("Location", location)
        // 3xx 响应通常带一小段 body 给不支持跳转的老客户端看。
        // 现代客户端直接看 Location，但留一段话便于人工调试时
        // 用 curl 直接观察。
        r.headers.set("Content-Type", "text/plain; charset=utf-8")
        r.body = bbFromUtf8("重定向到 " + location)
        return r
    }

    // ── 便捷设置 ─────────────────────────────────

    fn setHeader(name: String, value: String) -> Response {
        self.headers.set(name, value)
        return self
    }

    fn addHeader(name: String, value: String) -> Response {
        self.headers.add(name, value)
        return self
    }

    // 加一个 Set-Cookie。
    fn addCookie(c: SetCookie) -> Response {
        arrPush(self.cookies, c)
        return self
    }

    fn setBodyText(s: String) -> Response {
        self.body = bbFromUtf8(s)
        return self
    }

    fn setBodyBytes(b: Array) -> Response {
        self.body = b
        return self
    }

    fn isSuccess() -> Bool {
        return self.status >= 200 && self.status < 300
    }

    fn bodyText() -> String {
        return bbToText(self.body)
    }

    // ── 序列化 ────────────────────────────────────

    // 生成完整响应报文（字节数组）。
    //
    // isHead 表示这是对 HEAD 请求的响应：头照常（含 Content-Length），
    // 但不输出 body。
    //
    // withDate 由调用方决定是否自动加 Date 头 —— 因为测试时需要
    // 确定性输出，自动加 Date 会让断言不稳定。
    fn serialize(isHead: Bool, withDate: Bool, httpDate: String) -> Array {
        // ── 一致性检查与自动修正 ─────────────────
        //
        // 顺序很重要：先处理「不该有 body」的情况（它决定了
        // Content-Length 该不该有），再补 Content-Length。

        var effectiveBody = self.body
        let noBody = hsHasNoBody(self.status)

        if (noBody && len(self.body) > 0) {
            // 204/304 带 body 是协议违规。这里**丢弃** body 而不是
            // 报错 —— 因为调用方可能复用了同一个 Response 对象改状态
            // 码（200 → 304），此时 body 是上一个状态留下的残留。
            // 报错会让这种常见写法变得难用，而静默丢弃不会造成错误
            // 的线上行为（本来 304 就不该带内容）。
            effectiveBody = []
        }

        var reason = self.reason
        if (len(reason) == 0) {
            reason = hsReason(self.status)
            if (len(reason) == 0) {
                // 未知状态码：给一个中性的短语，而不是空串。
                // 空串会让响应行变成 `HTTP/1.1 599 ` —— 有些严格的
                // 客户端会因此解析失败。
                reason = "Unknown"
            }
        }

        var out = self.version + " " + toString(self.status) + " " + reason + "\r\n"

        // ── Content-Length ───────────────────────
        //
        // 三种情况：
        //   1. 不该有 body（204/304/1xx）→ 不发 Content-Length
        //   2. 用户已显式设置 → 尊重用户的（但后面会检查一致性）
        //   3. 否则 → 按 body 实际长度补
        //
        // 为什么情况 1 不发：RFC 7230 §3.3.2 说 1xx/204 的响应
        // 「不能包含 message body」，「Content-Length: 0」虽然常见
        // 但严格说是多余的；304 则要求按「对应 GET 的长度」给，
        // 而这里不知道那个长度，所以不发比发个 0 更安全（发 0 会让
        // 缓存以为资源变空了）。
        if (!noBody && !self.headers.has("content-length")) {
            self.headers.set("Content-Length", toString(len(effectiveBody)))
        }

        if (withDate && len(httpDate) > 0 && !self.headers.has("date")) {
            self.headers.set("Date", httpDate)
        }

        out = out + self.headers.toText()

        // Set-Cookie 每条一行。
        var i = 0
        while i < len(self.cookies) {
            let c: SetCookie = self.cookies[i]
            out = out + "Set-Cookie: " + c.toHeaderValue() + "\r\n"
            i = i + 1
        }

        out = out + "\r\n"        // 空行 = 头结束

        var head = bbFromUtf8(out)

        // HEAD：头已完整（含 Content-Length），body 不输出。
        if (isHead) { return head }
        if (len(effectiveBody) == 0) { return head }
        return bbConcat(head, effectiveBody)
    }

    // 只序列化头部（不带 Date，测试用）。
    fn serializeForTest(isHead: Bool) -> Array {
        return self.serialize(isHead, false, "")
    }

    fn describe() -> String {
        return "Response " + toString(self.status) + " " + hsReason(self.status) +
               " (" + toString(len(self.body)) + " body 字节, " +
               toString(self.headers.count()) + " 头, " +
               toString(len(self.cookies)) + " cookie)"
    }
}