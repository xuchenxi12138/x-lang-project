from "http/router.xle" import rnNormalizePattern, rnMatchPattern, rnSplitSegs, arrHas, Route, Match, Router
from "http/server.xle" import hsHttpDateNow, Context, HttpServer

// ── 能力说明 ──────────────────────────────────
//
// 与 db/index.xle 的 dbSupportMatrix 对应：让调用方在运行前就能
// 看清哪些能力是真的可用、哪些有边界。
fn netSupportMatrix() -> Array {
    return [
        ["TCP 监听/连接",       "完整", "IPv4；监听与连接均为非阻塞 + 轮询"],
        ["TCP 收发",            "完整", "send 返回实际字节数；sendAll 循环至发完"],
        ["UDP",                 "无",   "语言无 UDP 内建"],
        ["IPv6 连接",           "无",   "平台层只用 AF_INET；URL 里可解析但不用于连接"],
        ["HTTP/1.1 客户端",     "完整", "Content-Length / chunked / 读到关闭 三种 body"],
        ["HTTP/1.1 服务端",     "完整", "单线程 accept 循环；Connection: close"],
        ["HTTP keep-alive",     "无",   "单线程模型下复用连接比关闭更慢"],
        ["HTTPS / TLS",         "无",   "语言无 TLS 内建；需前置反向代理"],
        ["HTTP/2",              "无",   "只用文本帧"],
        ["WebSocket",           "无",   "需要帧编解码与长连接升级，未实现"],
        ["URI 解析",            "完整", "含 IPv6 字面量、userinfo、点段归一化"],
        ["Cookie",              "完整", "请求解析 + SetCookie 生成 + 错误配置检测"],
        ["路由",                "完整", "参数、通配、405、HEAD 复用 GET"],
        ["gzip",                "无",   "语言无 zlib 内建"]
    ]
}

fn netSupportSummary() -> String {
    let rows = netSupportMatrix()
    var out = "网络层能力矩阵"
    var i = 0
    while i < len(rows) {
        let r: Array = rows[i]
        let name: String = r[0]
        let state: String = r[1]
        let note: String = r[2]
        out = out + "\n    " + strPadRight(name, 22, " ") +
              strPadRight("[" + state + "]", 8, " ") + " " + note
        i = i + 1
    }
    return out
}