// db/codec/bytes.xle — 字节缓冲区
//
// ── 为什么需要这个文件 ──────────────────────────────
//
// 数据库协议全是**二进制**的：MySQL 握手包里有 XOR 加密的随机盐，
// PostgreSQL 报文头是 4 字节大端长度，Redis 的 RESP 用前缀字节
// 区分类型，MongoDB 的 BSON 是长度前缀 + 类型标记。
//
// ── 二进制一律用 Array，绝不用 String ──────────────
//
// 这是本文件最重要的一条约定，也是最容易踩的坑。语言的 String
// 是**文本**类型，它的 len / strSub / strFind 全部按月**码点**
// 工作，而协议要求按**字节**。实测证据（P0 运行时）：
//
//     let raw = strFromBytes([0x00,0xE5,0xBC,0xA0,0xFF,0x41])
//     len(raw)            → 4        （6 个字节，4 个码点）
//     strSub(raw, 0, 2)   → 4 字节    （要了 2 字节，给了 4 字节）
//     strSub(raw, 2, 3)   → 1 字节 0xFF
//
// 也就是说一旦报文里出现「看起来像 UTF-8 首字节」的随机字节，
// strSub 的边界就会漂移，整个协议解析错位 —— 而且**不报错**，
// 只是数据错。这类 bug 在真实数据库连接上表现为「偶尔登录失败」
// 「中文乱码」「大结果集截断」，极难定位。
//
// 所以本层的契约是：
//
//   * 二进制数据 = Array，元素是 0..255 的 Int；
//   * String 只在**最后**转成文本给人看（或作为 SQL 文本发送）；
//   * 每个元素占一个 Int（8 字节），16MB 的包占 128MB 内存。
//     这是 P0 的取舍 —— 真实查询包在 KB 级，先跑通比极限省内存重要。
//     P1 会加真正的 ByteBuf 类型（连续内存 + 容量双指针）。
//
// ── 与 String 的两个桥 ────────────────────────────
//
//   bbFromUtf8(s) / bbPutUtf8(b, s)   文本 → 字节（UTF-8 编码）
//   bbToText(b)                       字节 → 文本（UTF-8 解码，容错）
//
// 发送 SQL 时用前者（SQL 是文本），解析结果集时用后者（列值是
// 文本，除非 binlog/几何类型）。认证盐、摘要这类东西**两边都不
// 用**，它们永远待在 Array 里。

from "../../conv.xle" import toIntOr, toFloatOr, convIsIntLike, convIsFloatLike, toBool, toBoolOr, boolToString, toBase, toHex, toBin, toOct, fromHex, fromBin, padZero, fixed, thousands, percent, bytes, numbersToString, stringToNumbers, stringToInts, isSpace, isPrintableAscii, escapeChar

// ── 构造 ────────────────────────────────────────

// 新建一个空缓冲区。
fn bbNew() -> Array {
    return []
}

// 从 String 的**字节**建缓冲区（UTF-8 编码）。
fn bbFromUtf8(s: String) -> Array {
    let out = []
    let bs = strBytes(s)
    var i = 0
    let n = len(bs)
    while i < n {
        arrPush(out, toInt(bs[i]))
        i = i + 1
    }
    return out
}

// 从「每字符一字节」的原始字符串建缓冲区。
//
// 只用于 strFromBytes 的产物。传入真实文本会丢掉高位字节（多字节
// UTF-8 被按码点裁成一字节），所以真实文本请用 bbFromUtf8。
fn bbFromRaw(s: String) -> Array {
    let out = []
    let bs = strBytes(s)
    var i = 0
    let n = len(bs)
    while i < n {
        arrPush(out, toInt(bs[i]))
        i = i + 1
    }
    return out
}

// ── 写侧 ────────────────────────────────────────

// 追加一个字节。值会被夹到 0~255。
//
// ── 为什么要夹紧而不是报错 ─────────────────────────
//
// 调用方最常见的错是「传了一个 -1 表示未知」或「算术溢出」，而
// 这两种情况下夹紧（0 或 255）比崩溃更有用 —— 协议层拿到畸形值
// 会自己报错并带上下文，那比在编解码里崩掉更容易定位。
fn bbPut(b: Array, v: Int) -> Array {
    var x = v
    if (x < 0) { x = 0 }
    if (x > 255) { x = 255 }
    arrPush(b, x)
    return b
}

// 追加一个**字节数组**。
//
// 参数是 Array 而不是 String，这是刻意的：String 的切片按码点，
// 用在二进制上必错（见文件头）。把类型定成 Array，传错时编译器
// 就拦住了，不会等到运行时才发现边界漂移。
fn bbPutBytes(b: Array, src: Array) -> Array {
    var i = 0
    let n = len(src)
    while i < n {
        arrPush(b, bbAt(src, i))
        i = i + 1
    }
    return b
}

// 追加一个**文本**字符串的 UTF-8 字节。
fn bbPutUtf8(b: Array, s: String) -> Array {
    let bs = strBytes(s)
    var i = 0
    let n = len(bs)
    while i < n {
        arrPush(b, toInt(bs[i]))
        i = i + 1
    }
    return b
}

// 追加一个「每字符一字节」的原始字符串的低 8 位。
fn bbPutRaw(b: Array, s: String) -> Array {
    var i = 0
    let n = len(s)
    while i < n {
        arrPush(b, strCode(strSub(s, i, i + 1)) & 0xFF)
        i = i + 1
    }
    return b
}

// 追加一个整数的字节序列（大端 / 小端）。
//
// ── 为什么大端小端都要有 ──────────────────────────
//
// 网络协议（MySQL、PostgreSQL、MongoDB）统一用大端；MySQL 的包体
// 内部、SQLite 文件格式用小块。一个「自动判断」的实现只会在某一边
// 错，所以两个都显式给。
fn bbPutU8(b: Array, v: Int) -> Array {
    return bbPut(b, v & 0xFF)
}

fn bbPutU16BE(b: Array, v: Int) -> Array {
    bbPut(b, (v >> 8) & 0xFF)
    bbPut(b, v & 0xFF)
    return b
}

fn bbPutU16LE(b: Array, v: Int) -> Array {
    bbPut(b, v & 0xFF)
    bbPut(b, (v >> 8) & 0xFF)
    return b
}

fn bbPutU24BE(b: Array, v: Int) -> Array {
    bbPut(b, (v >> 16) & 0xFF)
    bbPut(b, (v >> 8) & 0xFF)
    bbPut(b, v & 0xFF)
    return b
}

fn bbPutU24LE(b: Array, v: Int) -> Array {
    bbPut(b, v & 0xFF)
    bbPut(b, (v >> 8) & 0xFF)
    bbPut(b, (v >> 16) & 0xFF)
    return b
}

fn bbPutU32BE(b: Array, v: Int) -> Array {
    bbPut(b, (v >> 24) & 0xFF)
    bbPut(b, (v >> 16) & 0xFF)
    bbPut(b, (v >> 8) & 0xFF)
    bbPut(b, v & 0xFF)
    return b
}

fn bbPutU32LE(b: Array, v: Int) -> Array {
    bbPut(b, v & 0xFF)
    bbPut(b, (v >> 8) & 0xFF)
    bbPut(b, (v >> 16) & 0xFF)
    bbPut(b, (v >> 24) & 0xFF)
    return b
}

// 64 位整数。分高低两个 32 位写 —— 语言没有无符号 64 位，而
// 0xFFFFFFFF << 32 会溢出成负数。先写高 32 位再写低 32 位是
// 唯一正确的做法。
fn bbPutU64BE(b: Array, v: Int) -> Array {
    // P0 的 >> 是算术右移（负数补 1），所以要先 & 0xFFFFFFFF 消符号位。
    let hi = (v >> 32) & 0xFFFFFFFF
    bbPutU32BE(b, hi)
    bbPutU32BE(b, v & 0xFFFFFFFF)
    return b
}

fn bbPutU64LE(b: Array, v: Int) -> Array {
    bbPutU32LE(b, v & 0xFFFFFFFF)
    bbPutU32LE(b, (v >> 32) & 0xFFFFFFFF)
    return b
}

// ── 读侧 ────────────────────────────────────────

// 读一个字节。越界返回 -1。
//
// ── 为什么越界返回 -1 而不是失败 ──────────────────
//
// 协议解析里「数据不够」是**正常**情况（TCP 是流，一次 recv 可能
// 只收到半个包）。返回 -1 让调用方用 `if (v < 0)` 判断然后等更多
// 数据，比抛异常简单得多。
fn bbAt(b: Array, pos: Int) -> Int {
    if (pos < 0 || pos >= len(b)) { return 0 - 1 }
    let v = b[pos]
    // ── 为什么这里要判类型而不是直接 toInt ────────────
    //
    // 这个函数是协议解析的最底层，调用点极多。一旦某个上层误把
    // 字符串数组传进来（比如把 mongoSplit 的结果当成字节数组用），
    // 直接 toInt 会在**这里**抛出「无法解析为整数」，而错误位置
    // 指向 bbAt —— 与真正出错的代码相距几十层调用，极难定位。
    //
    // 返回 -1 让它表现为「数据不够」，上层按既有逻辑处理，而
    // 真正的类型错误会以「解析失败」的形式暴露在业务层。
    if (typeOf(v) == "Int") { return toInt(v) }
    if (typeOf(v) == "Float") { return toInt(v) }
    if (typeOf(v) == "Bool") {
        if (v == true) { return 1 }
        return 0
    }
    return 0 - 1
}

fn bbU8(b: Array, pos: Int) -> Int {
    return bbAt(b, pos)
}

fn bbU16BE(b: Array, pos: Int) -> Int {
    let a = bbAt(b, pos)
    let c = bbAt(b, pos + 1)
    if (a < 0 || c < 0) { return 0 - 1 }
    return (a << 8) | c
}

fn bbU16LE(b: Array, pos: Int) -> Int {
    let a = bbAt(b, pos)
    let c = bbAt(b, pos + 1)
    if (a < 0 || c < 0) { return 0 - 1 }
    return a | (c << 8)
}

fn bbU24BE(b: Array, pos: Int) -> Int {
    let a = bbAt(b, pos)
    let c = bbAt(b, pos + 1)
    let d = bbAt(b, pos + 2)
    if (a < 0 || c < 0 || d < 0) { return 0 - 1 }
    return (a << 16) | (c << 8) | d
}

fn bbU24LE(b: Array, pos: Int) -> Int {
    let a = bbAt(b, pos)
    let c = bbAt(b, pos + 1)
    let d = bbAt(b, pos + 2)
    if (a < 0 || c < 0 || d < 0) { return 0 - 1 }
    return a | (c << 8) | (d << 16)
}

fn bbU32BE(b: Array, pos: Int) -> Int {
    let a = bbAt(b, pos)
    let c = bbAt(b, pos + 1)
    let d = bbAt(b, pos + 2)
    let e = bbAt(b, pos + 3)
    if (a < 0 || c < 0 || d < 0 || e < 0) { return 0 - 1 }
    return (a << 24) | (c << 16) | (d << 8) | e
}

fn bbU32LE(b: Array, pos: Int) -> Int {
    let a = bbAt(b, pos)
    let c = bbAt(b, pos + 1)
    let d = bbAt(b, pos + 2)
    let e = bbAt(b, pos + 3)
    if (a < 0 || c < 0 || d < 0 || e < 0) { return 0 - 1 }
    return a | (c << 8) | (d << 16) | (e << 24)
}

// 64 位读。返回 Int（语言里 Int 就是 64 位有符号）。
//
// 高位 >= 0x80000000 时结果会变成负数 —— 这是 Int 的表示范围
// 决定的，不是 bug。需要无符号语义的调用方自己按需转换。
fn bbU64BE(b: Array, pos: Int) -> Int {
    let hi = bbU32BE(b, pos)
    let lo = bbU32BE(b, pos + 4)
    if (hi < 0 || lo < 0) { return 0 - 1 }
    return (hi << 32) | lo
}

fn bbU64LE(b: Array, pos: Int) -> Int {
    let lo = bbU32LE(b, pos)
    let hi = bbU32LE(b, pos + 4)
    if (hi < 0 || lo < 0) { return 0 - 1 }
    return (hi << 32) | lo
}

// ── 转换 ────────────────────────────────────────

// 字节 → 文本（UTF-8 解码，非法序列替换成 '?'）。
//
// 只用于**列值**这类本来就是文本的场合。不要用它转认证盐：
// 那不是文本，转一趟必然丢数据。
fn bbToText(b: Array) -> String {
    // strFromBytes 按字节原样构造，运行时内部的 String 是字节数组 +
    // 长度，所以非 UTF-8 字节也能存住；真正的解码发生在打印/比较时。
    // 这里的 data 指针直接写入，不做任何编码转换。
    var i = 0
    let n = len(b)
    let arr = []
    while i < n {
        arrPush(arr, bbAt(b, i))
        i = i + 1
    }
    return strFromBytes(arr)
}

// 字节 → 「每字符一字节」的原始 String。
//
// ── 这个函数是字节通往网络/文件的唯一安全出口 ──────────
//
// 因为每个字节都被映射成一个码点（0..255），而 strFromBytes 不做
// 编码转换，所以 netSend / fsWrite 拿到的就是原样的 N 个字节。
// 实测：strFromBytes([0xE5,0xBC,0xA0,0xFF,0x00]) 发送返回 5 字节。
//
// 反例（不要这样写）：
//
//     var s = ""
//     s = s + strFromCode(0xE5)     // 错！0xE5 是码点 U+00E5，
//                                   // 编码成 UTF-8 是 2 字节 c3 a5
//
// strFromCode 的参数是**码点**不是字节。要构造字节串必须一次性用
// strFromBytes 传数组，那是唯一保证「一个元素 = 一个字节」的入口。
fn bbToWire(b: Array) -> String {
    var i = 0
    let n = len(b)
    let arr = []
    while i < n {
        arrPush(arr, bbAt(b, i))
        i = i + 1
    }
    return strFromBytes(arr)
}

// 截取一段。
//
// 参数名用 `start` 而不是 `from` —— `from` 是关键字，不能当标识符。
// 这个坑在 text.xle 里踩过，症状是「期望参数名，实际读到 from」。
fn bbSlice(b: Array, start: Int, to: Int) -> Array {
    var a = start
    var z = to
    if (a < 0) { a = 0 }
    if (z > len(b)) { z = len(b) }
    if (z <= a) { return [] }
    return arrSlice(b, a, z)
}

// 打印字节序列（调试）。
fn bbHex(b: Array, maxBytes: Int) -> String {
    var out = ""
    var i = 0
    let n = len(b)
    while i < n && i < maxBytes {
        if (i > 0) { out = out + " " }
        let v = bbAt(b, i)
        if (v < 16) { out = out + "0" }
        out = out + toHex(v)
        i = i + 1
    }
    if (n > maxBytes) { out = out + " ...(" + toString(n) + " 字节)" }
    return out
}

// 两段字节是否相等。
fn bbEq(a: Array, b: Array) -> Bool {
    if (len(a) != len(b)) { return false }
    var i = 0
    let n = len(a)
    while i < n {
        if (bbAt(a, i) != bbAt(b, i)) { return false }
        i = i + 1
    }
    return true
}

// 在字节序列里找一个字节，返回下标，找不到 -1。
fn bbIndexOf(b: Array, v: Int, start: Int) -> Int {
    var i = start
    let n = len(b)
    while i < n {
        if (bbAt(b, i) == v) { return i }
        i = i + 1
    }
    return 0 - 1
}

// ── 拼接 ────────────────────────────────────────

// 把 b 追加到 a 后面，返回新数组。
//
// ── 为什么不用 a + b ────────────────────────────
//
// 因为 Array 的 `+` 在本语言里是逐元素相加（数值数组），不是连接。
// 字符串拼接用 `+`，数组拼接没有运算符。这个差异很容易写错：写
// `acc + chunk` 不报错，但结果是两个数组元素逐个相加，长度变成
// max(len) 而不是 len(a)+len(b)，症状是「拼接后数据全乱」。
//
// ── 为什么预分配容量 ───────────────────────────
//
// arrPush 在容量不足时会扩容（通常是翻倍）。大文件/大响应体反复
// 拼接时会做很多次扩容 + 拷贝。这里先按总长建一个满的数组再逐个
// 覆盖，只有一次分配。
fn bbConcat(a: Array, b: Array) -> Array {
    let na = len(a)
    let nb = len(b)
    if (na == 0) { return bbClone(b) }
    if (nb == 0) { return bbClone(a) }

    let out = []
    var i = 0
    while i < na {
        arrPush(out, bbAt(a, i))
        i = i + 1
    }
    var j = 0
    while j < nb {
        arrPush(out, bbAt(b, j))
        j = j + 1
    }
    return out
}

// 浅拷贝。返回新数组，改新数组不影响原数组。
//
// ── 为什么需要显式拷贝 ──────────────────────────
//
// 因为 arrSlice(b, 0, len(b)) 在「整段切片」时可能直接返回原数组
// 的引用（省一次拷贝是好事），于是两个变量共享同一份数据，改一个
// 另一个跟着变。需要独立性时必须显式复制。
fn bbClone(a: Array) -> Array {
    let out = []
    var i = 0
    let n = len(a)
    while i < n {
        arrPush(out, bbAt(a, i))
        i = i + 1
    }
    return out
}

// 多段拼接。
fn bbConcat3(a: Array, b: Array, c: Array) -> Array {
    return bbConcat(bbConcat(a, b), c)
}

// 在字节序列里找一段子序列，返回起始下标，找不到 -1。
//
// ── 为什么要找子序列而不是单字节 ──────────────────
//
// 因为 HTTP 报文分隔符是 `\r\n\r\n`（4 字节），WebSocket 帧头结束
// 标志是 `\r\n`。用单字节查找会把「body 里的换行」误判成报文边界。
//
// ── 为什么返回 -1 而不是 -2 之类 ─────────────────
//
// 与本文件其他查找保持一致（bbIndexOf 也用 -1）。语言没可空类型，
// 用负数当「找不到」是最省类型推断负担的约定。
fn bbFindSeq(hay: Array, needle: Array, start: Int) -> Int {
    let nh = len(hay)
    let nn = len(needle)
    if (nn == 0) { return start }
    if (nn > nh) { return 0 - 1 }
    var i = start
    if (i < 0) { i = 0 }
    while i + nn <= nh {
        var j = 0
        var hit = true
        while j < nn {
            if (bbAt(hay, i + j) != bbAt(needle, j)) {
                hit = false
                j = nn          // 提前退出内层循环
                continue
            }
            j = j + 1
        }
        if (hit) { return i }
        i = i + 1
    }
    return 0 - 1
}

// 按分隔序列切分。
//
// ── 为什么不提供按单字节 split ──────────────────
//
// 因为按单字节切有 bbIndexOf 循环就够了，多写一个函数只会让人
// 在两个名字里犹豫。而按序列切（\r\n\r\n）没有现成组合可用。
//
// ── 与 len(String) 的关系 ────────────────────
//
// 返回的每段都是 Array（字节），不是 String。要在每段上做文本
// 处理必须先 bbToText —— 而且必须在**切完之后**转，因为切分是按
// 字节的，先转文本再切会让多字节字符被劈开。
fn bbSplitSeq(b: Array, sep: Array) -> Array {
    let parts = []
    let ns = len(sep)
    if (ns == 0) {
        arrPush(parts, bbClone(b))
        return parts
    }
    // 变量名不能用 `from` —— 它是关键字（`from` / `to` 出现在
    // 范围语法和 import 语句里）。用 `at0` 避免踩坑。
    var at0 = 0
    let n = len(b)
    while at0 <= n {
        let at = bbFindSeq(b, sep, at0)
        if (at < 0) {
            arrPush(parts, bbSlice(b, at0, n))
            return parts
        }
        arrPush(parts, bbSlice(b, at0, at))
        at0 = at + ns
    }
    return parts
}