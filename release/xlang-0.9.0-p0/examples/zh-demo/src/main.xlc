打印行(降序排序(zs)[0])
打印行(长度(交集(取段(ys, 0, 2), 取段(ys, 0, 2))))
打印行(长度(并集(取前n个(ys, 2), 去前n个(ys, 2))))
打印行(长度(差集(取段(ys, 0, 2), 取段(ys, 1, 2))))

// ── 文件 ──────────────────────────────────────────────
令 p = "zh_demo_测试.txt"
写文件(p, "第一行\n第二行\n")
打印行(存在吗(p))
打印行(长度(按行读(p)))
打印行(读文件(p) == "第一行\n第二行\n")
追加一行(p, "第三行")
打印行(读文件或(p, "缺") == "第一行\n第二行\n第三行\n")
打印行(取扩展名(p))
打印行(拼路径("目录", "文件.txt"))
打印行(文件大小(p) > 0)
打印行(删除文件(p))
打印行(存在吗(p))

