// 47-string-interp.xle — 字符串插值 `"a{x}b"`
//
// 规范 01 §3.6 早已定义该语法（`{expr}` 插值，`{{` `}}` 转义），
// 词法层也一直保留着 `\{` 的转义通道，但真正把 `{...}` 变成表达式
// 求值的那一步没做。这里补上。
//
// ── 降级在 parser 侧，不加新字节码 ──────────────────
//
// `"a{x}b"` 拆成 `"a" + (x) + "b"`。`+` 对 String 与任意右操作数
// 已有「转字符串再拼」的语义，所以不需要任何新指令、新节点。
//
// ── 为什么要看 raw（转义原文）而不是已 unescape 的 s ────
//
// `"{{"` 是转义的 `{`，`"{x}"` 是插值 —— 而 unescape 之后两者都是
// 裸 `{`，信息已经丢了。所以 Token 里另存一份 raw，拆段扫 raw。
//
// ── 两个层级之间的接缝 ─────────────────────────
//
// 插值内容要重新过一遍 **lexer**，而外层把整串当「一串字符」扫。
// 于是 `{a ? "x" : "y"}` 里的引号在外层必须写成 `\"`，但在内层
// 必须是裸 `"` —— 子 lexer 不认「前面没有开引号的 `\"`」，会报
// 「无法识别的字符 `\`」。所以拆段时先把 `\"` / `\'` 还原成裸引号。

struct P { x: Int, y: Int }

fn f(a: Int) -> Int {
    return a * 2
}

fn main() -> Int {
    // ---- 1. 基本 ----
    let n = 42
    println("n={n}")                          // n=42

    // ---- 2. 与字面量混合 ----
    let i = 3
    println("第 {i} 项，共 {i + 1} 项")        // 第 3 项，共 4 项
    println("共{n}个")                         // 共42个

    // ---- 3. 表达式插值 ----
    println("f(5)={f(5)}")                    // f(5)=10
    let p = P { x: 1, y: 2 }
    println("p=({p.x},{p.y})")                // p=(1,2)

    // ---- 4. 含运算符与括号 ----
    println("{1 + 2 * 3}")                    // 7
    println("{(1 + 2) * 3}")                  // 9

    // ---- 5. 插值里含字符串（外层写 `\"`）----
    println("r={n > 40 ? \"big\" : \"small\"}")  // r=big

    // ---- 6. 插值里含空值合并 ----
    let z = null
    println("z={z ?? 7}")                     // z=7

    // ---- 7. 插值里含 match ----
    println("k={match n { 42 => \"答案\", _ => \"其它\" }}")   // k=答案

    // ---- 8. 转义：{{ }} 输出字面花括号 ----
    println("{{literal}}")                    // {literal}
    println("a\{n}")                          // a{n}  —— \{ 也是字面 {

    // ---- 9. 多个插值 ----
    println("{n}+{n}={n + n}")                // 42+42=84

    // ---- 10. 只有插值，没有字面量 ----
    println("{n}")                            // 42

    // ---- 11. 插值结果再参与拼接 ----
    let s = "值=" + "{n}"
    println(s)                                // 值=42

    // ---- 12. 空字符串与非插值花括号共存 ----
    let plain = "no braces here"
    println(plain)                            // no braces here

    // ---- 13. 插值里含数组字面量与下标 ----
    let a = [10, 20, 30]
    println("a[1]={a[1]} len={len(a)}")        // a[1]=20 len=3

    // ---- 14. 浮点插值 ----
    println("x={1.5 + 0.25}")                  // x=1.75

    // ---- 15. 布尔插值 ----
    println("ok={n > 0}")                      // ok=true

    return 0
}