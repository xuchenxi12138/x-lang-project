// 50-new-syntax-zh.xlc — 中文模式下新语法必须零成本
//
// run_tests.sh 的约定：文件名以 `-zh` 结尾的 `.xlc`，会与同名的
// `-zh-en.xle` 比对**逐条指令一致**。所以这个文件不重复测功能
// （那由 .expect 负责），它的唯一目的是证明 match / 三元 /
// 数组字面量 / `??` / 字符串插值 在中文关键字下生成的字节码
// 与英文版完全相同 —— 中文化只发生在词法层，不进入编译。
//
// 语言名不能用 `空`：它是 `null` 的中文关键字（TK_NULL 的别名），
// 拿来做标识符会报「let 之后期望一个变量名」。

fn classify(n: 整数) -> 字符串 {
    返回 匹配 n {
        0           => "零",
        1..=9       => "一位数",
        v @ 10..=99 => "两位数:{v}",
        _           => "大数",
    }
}

fn main() -> Int {
    令 a = [1, 2, 3]
    令 空表 = []
    令 s = a[0] > 0 ? "正" : "负"
    // 空数组不是 null —— 这一行验证「?? 只认 null，不认空容器」
    令 z = 空表 ?? 5
    println(s)
    println(len(z))          // 0（不是 5，说明空数组没被当成 null）
    println(classify(42))

    // 插值里用中文标识符
    令 名字 = "世界"
    println("你好，{名字}")
    返回 0
}